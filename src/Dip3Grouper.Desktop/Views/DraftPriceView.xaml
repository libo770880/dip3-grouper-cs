<UserControl x:Class="Dip3GrouperApp.Desktop.Views.DraftPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dip3GrouperApp.Desktop"
             xmlns:views="clr-namespace:Dip3GrouperApp.Desktop.Views"
             xmlns:ctl="clr-namespace:Dip3GrouperApp.Desktop.Controls">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ 标题行：页名 + 视图分段切换 ============ -->
    <Grid Grid.Row="0" Margin="2,0,0,10">
      <TextBlock Style="{StaticResource PageTitle}" Text="新项目征求意见" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Style="{StaticResource Segment.Bar}" ctl:Segment.Track="True">
          <Grid>
            <Border Style="{StaticResource Segment.Slide}" />
            <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SegNew" GroupName="DraftView" Style="{StaticResource Segment.Item}"
                         Content="新增项目" IsChecked="True" Checked="OnViewChanged"
                         ToolTip="本批拟新增的立项指南项目（价格未生效）" />
            <RadioButton x:Name="SegCancel" GroupName="DraftView" Style="{StaticResource Segment.Item}"
                         Content="废止对照" Checked="OnViewChanged"
                         ToolTip="本批拟作废的原价格项目，及其对应的新项目" />
            <RadioButton x:Name="SegMap" GroupName="DraftView" Style="{StaticResource Segment.Item}"
                         Content="映射关系" Checked="OnViewChanged"
                         ToolTip="通知附件「映射关系表」原始两列：新立项指南项目 ↔ 原价格项目" />
            <RadioButton x:Name="SegCmp" GroupName="DraftView" Style="{StaticResource Segment.Item}"
                         Content="新旧价格比对" Checked="OnViewChanged"
                         ToolTip="新项目价格 ↔ 旧物价价格（以旧版物价 45 号对码表为基准），看涨跌差额" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ============ 顶部黄条：征求意见稿提示（有数据才显示） ============ -->
    <Border x:Name="DraftBanner" Grid.Row="1" Margin="0,0,0,10" CornerRadius="10" Padding="13,10"
            Background="{DynamicResource B.DraftBg}"
            BorderBrush="{DynamicResource B.DraftBorder}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource DraftTag}" Margin="0,0,10,0"
                VerticalAlignment="Top">
          <TextBlock Style="{StaticResource DraftTagText}" Text="征求意见稿" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="TxtDraftTitle" FontSize="13" FontWeight="SemiBold"
                     TextWrapping="Wrap" Foreground="{DynamicResource B.DraftFg}" />
          <TextBlock x:Name="TxtDraftNote" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.DraftFg}" Opacity="0.88" />
        </StackPanel>
        <TextBlock x:Name="TxtDraftRefs" Grid.Column="2" FontSize="11.5" Margin="12,0,0,0"
                   VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="300"
                   Foreground="{DynamicResource B.DraftFg}" Opacity="0.8" />
      </Grid>
    </Border>

    <!-- ============ 类别级「使用说明」（对齐主库物价页，按当前类别联动） ============ -->
    <Border x:Name="UsageCard" Grid.Row="2" Margin="0,0,0,10" CornerRadius="10" Padding="12,9"
            Background="{DynamicResource B.InfoBg}" BorderBrush="{DynamicResource B.InfoBorder}"
            BorderThickness="1" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource ChipText}" Text="使用说明"
                       Foreground="{DynamicResource B.InfoText}" />
          </Border>
          <TextBlock Grid.Column="1" x:Name="UsageTitle" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource B.InfoText}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Margin="2,0,8,0" />
          <Button Grid.Column="2" x:Name="UsageToggle" Style="{StaticResource Btn.Link}"
                  Content="收起" Click="OnToggleUsage" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="UsageBody" MaxHeight="170" Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="UsageList" ItemTemplate="{StaticResource Usage.Item}" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============ 筛选栏 ============ -->
    <!-- 分两段：筛选控件可换行；「状态 + 导出」单独一行，导出按钮不会与筛选控件抢位置而错行 -->
    <StackPanel Grid.Row="3" Margin="0,0,0,10">
    <WrapPanel x:Name="FilterBar" Orientation="Horizontal">
      <ComboBox x:Name="CatSel" Style="{StaticResource Cb}" Width="176" Margin="0,0,8,0"
                ToolTip="按类别筛选（本批各类别）" SelectionChanged="OnFilterChanged" />
      <ComboBox x:Name="KindSel" Style="{StaticResource Cb}" Width="118" Margin="0,0,8,0"
                Visibility="Collapsed"
                ToolTip="按项目性质筛选（主项 / 加收项 / 扩展项）" SelectionChanged="OnFilterChanged" />
      <ComboBox x:Name="ScopeSel" Style="{StaticResource Cb}" Width="138" Margin="0,0,8,0"
                Visibility="Collapsed" SelectionChanged="OnFilterChanged"
                ToolTip="比对范围：有旧价可比 / 纯新增项目（无旧项目可对照）" />
      <TextBox x:Name="DzQuery" Style="{StaticResource Tb}" Width="230" Margin="0,0,8,0"
               PreviewKeyDown="OnQueryKey" TextChanged="OnQueryText"
               ToolTip="编码 / 名称 / 服务产出 / 计价说明（映射视图同时检索两侧编码与名称）" />
      <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="0,0,8,0" Click="OnSearch" />
      <Button Style="{StaticResource Btn.Ghost}" Content="清 空" Margin="0,0,10,0" Click="OnClear"
              ToolTip="清空关键词与全部筛选" />
    </WrapPanel>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="DzStatus" Grid.Column="0" Style="{StaticResource Desc}"
                 VerticalAlignment="Center" Margin="2,0,12,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Button x:Name="ExpBtn" Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="导 出"
              HorizontalAlignment="Right" Click="OnExport" ToolTip="导出当前视图的筛选结果为 Excel" />
    </Grid>
    </StackPanel>

    <!-- ============ 三个视图共用同一网格位置，按视图切 Visibility ============ -->

    <!-- 视图 1：新增项目（整行淡黄 + 名称列角标） -->
    <DataGrid Grid.Row="4" x:Name="DraftGrid" Style="{StaticResource Dg.ReadOnly}"
              RowStyle="{StaticResource DgRow.Draft}"
              CanUserSortColumns="True" Sorting="OnSorting"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              local:RowMenu.Enable="True" local:DetailToggle.Enable="True"
              RowDetailsVisibilityMode="VisibleWhenSelected">
      <DataGrid.RowDetailsTemplate>
        <DataTemplate>
          <Border Margin="10,4,10,10" Background="{DynamicResource B.Card}"
                  BorderBrush="{DynamicResource B.DraftBorder}" BorderThickness="1"
                  CornerRadius="10" Padding="14,12">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="3" Style="{StaticResource Btn.Link}" Content="收起"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        local:DetailToggle.Collapse="True"
                        ToolTip="收起本行详情" />
                <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
                  <TextBox Style="{StaticResource Tx.Sel}" Text="{Binding Code, Mode=OneWay}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                </Border>
                <TextBox Grid.Column="1" Style="{StaticResource Tx.Sel}" Text="{Binding Name, Mode=OneWay}"
                         FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Grid.Column="2" Style="{StaticResource DraftTag}" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource DraftTagText}" Text="未生效" />
                </Border>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="三级 / 二级 / 一级" FontSize="12.5"
                           Foreground="{DynamicResource B.Muted}" VerticalAlignment="Top" />
                <TextBox Grid.Column="1" Style="{StaticResource Tx.Sel}" Text="{Binding PriceLine, Mode=OneWay}"
                         FontFamily="{StaticResource Font.Mono}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Blocks}"
                            ItemTemplate="{StaticResource Block.Tpl}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>
    </DataGrid>

    <!-- 视图 2：废止对照（拟作废原项目 → 新项目） -->
    <DataGrid Grid.Row="4" x:Name="CancelGrid" Style="{StaticResource Dg.ReadOnly}"
              RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Visibility="Collapsed" IsReadOnly="True"
              CanUserSortColumns="True" Sorting="OnSorting"
              local:RowMenu.Enable="True" />

    <!-- 视图 3：映射关系（两段式原始表） -->
    <DataGrid Grid.Row="4" x:Name="MapGrid" Style="{StaticResource Dg.ReadOnly}"
              RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Visibility="Collapsed" IsReadOnly="True"
              CanUserSortColumns="True" Sorting="OnSorting"
              local:RowMenu.Enable="True" />

    <!-- 视图 4：新旧价格比对（新项目 ↔ 旧物价，含差额与涨幅） -->
    <DataGrid Grid.Row="4" x:Name="CompareGrid" Style="{StaticResource Dg.ReadOnly}"
              RowStyle="{StaticResource DgRow.Draft}"
              RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Visibility="Collapsed" IsReadOnly="True"
              CanUserSortColumns="True" Sorting="OnSorting"
              local:RowMenu.Enable="True" />

    <!-- ============ 分页 ============ -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button x:Name="DzPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="上一页" Click="OnPrev" />
      <TextBlock x:Name="DzPageInfo" Style="{StaticResource Desc}" Margin="14,0"
                 VerticalAlignment="Center" />
      <Button x:Name="DzNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="下一页" Click="OnNext" />
    </StackPanel>
    <!-- 页面渐显：点「新增项目 / 废止对照 / 映射关系 / 新旧价格比对」时把整页压淡再淡回
         （控件本体见 Controls/BusyVeil）。切视图要重建筛选、重排 50 行，实测 200~400ms
         主线程全占满；不压淡的话页签白块没挪、表格还是旧内容，看着像「点了没生效」。
         ⚠ 必须与内容同级（控件按 Parent.Children 找兄弟统一压淡）。 -->
    <ctl:BusyVeil x:Name="Busy" Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="50" />
  </Grid>
</UserControl>
