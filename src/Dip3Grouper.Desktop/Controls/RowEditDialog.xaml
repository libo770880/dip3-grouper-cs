<Window x:Class="Dip3GrouperApp.Desktop.Controls.RowEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="编辑记录" Width="640" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.BorderStrong}"
          BorderThickness="1" CornerRadius="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.18" Color="#0f1728" />
    </Border.Effect>

    <DockPanel>
      <!-- 标题栏 -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource B.SoftBg}" CornerRadius="12,12,0,0"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid Height="44">
          <TextBlock x:Name="TxtTitle" Margin="18,0,0,0" VerticalAlignment="Center"
                     FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                     Text="编辑记录" />
          <Button Style="{StaticResource WinBtn.Close}" HorizontalAlignment="Right" Margin="0,0,6,0"
                  Click="OnCancel" ToolTip="关闭">
            <Path Style="{StaticResource WinIcon}"
                  Data="M 0.6 0.6 L 10.4 10.4 M 10.4 0.6 L 0.6 10.4" />
          </Button>
        </Grid>
      </Border>

      <!-- 底部按钮 -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource B.SoftBg}" CornerRadius="0,0,12,12"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Padding="18,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="TxtHint" Style="{StaticResource Desc}" VerticalAlignment="Center"
                     Margin="0,0,14,0" />
          <Button Style="{StaticResource Btn.Ghost}" Content="取 消" Click="OnCancel" />
          <Button Style="{StaticResource Btn.Primary}" Content="保 存" Margin="8,0,0,0" Click="OnSave" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
        <StackPanel x:Name="FieldHost" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
