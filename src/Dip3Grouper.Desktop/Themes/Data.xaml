<!--
  数据展示样式：DataGrid、卡片、徽章、详情键值对。
  表格遵循紧凑风格：行高 31、无竖线、表头浅底、选中淡蓝。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Dip3GrouperApp.Desktop">

  <!-- ==================================================================
       列宽拖拽手柄
       ==================================================================
       ⚠ 这是「表头拖不动列宽」的唯一原因：
       DataGridColumnHeader 的原生模板里有 PART_LeftHeaderGripper / PART_RightHeaderGripper
       两个 Thumb，DataGridColumnHeader.OnApplyTemplate 会把 DragDelta 挂到它们身上。
       我们自定义表头模板时若没放这两个部件，GetTemplateChild 拿到 null，
       拖拽逻辑整条链路断掉 —— 列宽写死多少就是多少，鼠标放上去连光标都不变。
       所以哪怕只为「能拖」，也必须保留这两个命名部件。

       视觉上平时完全透明（只占 8px 热区），悬停浮出一条浅竖线，拖动时变强调色，
       既提示了「这里能拖」，又不会把表头切成一格一格的竖线栅栏。
       ================================================================== -->
  <Style x:Key="ColGripper" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent">
            <Border x:Name="line" Width="1" HorizontalAlignment="Center"
                    Background="Transparent" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="line" Property="Background" Value="{DynamicResource B.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="line" Property="Background" Value="{DynamicResource B.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       DataGrid 表头
       ================================================================== -->
  <Style x:Key="DgHead" TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
    <Setter Property="Background" Value="{DynamicResource B.SoftBg}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <!--
                表头文字允许换行：列宽收紧时宁可折成两行，也不要被右侧硬裁掉半个字
                （「医保支付」曾显示成「医保支」、「自付比例」显示成「自付比」）。
                ContentPresenter 不能直接设 TextWrapping（不是它的属性），
                所以把 TextBlock 放进 ContentPresenter 的 Resources 里当隐式样式用。
                ⚠ HorizontalAlignment 与 HorizontalContentAlignment 必须**都**绑 TemplateBinding：
                模板里写死 Left 会吃掉各列自己的表头对齐设置（价格列要居中）。
              -->
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                RecognizesAccessKey="False">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <!-- 列宽拖拽热区：缺了这两个命名部件，DataGrid 的列宽拖拽会整条失效 -->
            <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource ColGripper}"
                   HorizontalAlignment="Left" />
            <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource ColGripper}"
                   HorizontalAlignment="Right" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.HoverBg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    数值列（价格 / 比例 / 差额 / 涨幅 / 序号）表头：在 DgHead 基础上改居中，
    让列头中线与下方数字中线对齐。
    ⚠ 模板里的 ContentPresenter 必须是 TemplateBinding HorizontalContentAlignment，
    否则这里改 Setter 完全不生效（早期写死 HorizontalAlignment="Left" 时踩过）。
  -->
  <Style x:Key="DgHeadCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHead}">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ==================================================================
       DataGrid 行
       ================================================================== -->
  <Style x:Key="DgRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource B.RowAlt}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.RowHover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.RowSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================================================================
       DataGrid 单元格
       ================================================================== -->
  <Style x:Key="DgCell" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <!-- 锁定前景：不依赖从行继承，避免系统选中态把文字染成 HighlightText（白） -->
    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <!-- HorizontalAlignment 必须绑 TemplateBinding，否则各列自己的
                 HorizontalContentAlignment（序号列要居中）完全不起作用 -->
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 单元格内文本（长文本省略 + 悬停提示由绑定 ToolTip 提供） -->
  <Style x:Key="DgCellText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style x:Key="DgCellMono" TargetType="TextBlock" BasedOn="{StaticResource DgCellText}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ==================================================================
       DataGrid 本体
       ================================================================== -->
  <Style x:Key="Dg" TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowHeight" Value="31" />
    <Setter Property="ColumnHeaderHeight" Value="34" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserSortColumns" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="False" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DgHead}" />
    <Setter Property="RowStyle" Value="{StaticResource DgRow}" />
    <Setter Property="CellStyle" Value="{StaticResource DgCell}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <!-- CanContentScroll 必须为 True：像素滚动会整体禁用 DataGrid 行虚拟化（2026-10-25），
         大页首次布局与滚动都显著变慢；行高自适应（RowHeight=NaN）在 item-scroll 下不受影响 -->
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
  </Style>

  <!-- 只读表格（禁选中高亮，用于点击展开详情的列表） -->
  <Style x:Key="Dg.ReadOnly" TargetType="DataGrid" BasedOn="{StaticResource Dg}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
  </Style>

  <!-- ==================================================================
       徽章（分组类型）
       ================================================================== -->
  <!-- 注意：StaticResource 需先定义后引用，故 E.Badge 必须排在 Badge 之前 -->
  <DropShadowEffect x:Key="E.Badge" BlurRadius="6" ShadowDepth="1" Direction="270"
                    Color="#000000" Opacity="0.28" />

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Effect" Value="{StaticResource E.Badge}" />
  </Style>

  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource B.White}" />
  </Style>

  <!-- ==================================================================
       结果卡 / 详情卡
       ================================================================== -->
  <Style x:Key="ResultCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- 详情键值对：左标签列 + 右值列 -->
  <Style x:Key="KvKey" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="KvVal" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- ==================================================================
       可选中的只读文本（详情卡 / 使用说明正文）
       外观与 TextBlock 完全一致（无边框、零内边距、透明底），但支持鼠标拖选 + Ctrl+C。
       ContextMenu 显式置空：右键统一交给所在行/卡片的菜单（内含各「复制」项），
       避免 WPF 默认的系统剪切板菜单盖住业务菜单。
       ================================================================== -->
  <Style x:Key="Tx.Sel" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    <Setter Property="ContextMenu" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        Margin="0" Padding="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================
       量表条（技术难度 / 风险程度 / 资源消耗）：圆角细轨道 + 左侧彩色填充
       ================================================================== -->
  <Style x:Key="Meter.Bar" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    CornerRadius="3" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 跨库关联链接行：蓝字 + 手型 + 悬停下划线，点击打开对应库详情弹窗 -->
  <Style x:Key="Link.Line" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" TextWrapping="Wrap"
                       FontFamily="{StaticResource Font.UI}" FontSize="12.5"
                       Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tx" Property="TextDecorations" Value="Underline" />
              <Setter Property="Foreground" Value="{DynamicResource B.AccentHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 编号前缀徽章（如加收项的 "01"） -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
  </Style>

  <!-- 提示条 -->
  <Style x:Key="Tag" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.WarnBg}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TagText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource B.WarnText}" />
  </Style>

  <!-- 分隔线 -->
  <Style x:Key="Hr" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource B.Border}" />
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <!-- ==================================================================
       详情卡共用模板（三库前台 + 关联弹窗共用一份，避免样式漂移）
       ⚠ 必须放在本字典末尾：StaticResource 只能引用「上面」已定义的键，
         Chip / ChipText / Link.Line / BoolToVis 都得先于这里出现。
       ================================================================== -->

  <!-- 详情卡的一行：徽章 + 文本；带 LinkLib 的关联行渲染为可点击链接（点击打开对应库详情弹窗） -->
  <DataTemplate x:Key="Line.Tpl">
    <Grid Margin="0,0,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,8,0"
              VerticalAlignment="Top"
              Visibility="{Binding HasChip, Converter={StaticResource BoolToVis}}">
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Chip}" />
      </Border>
      <!-- 值行用可选中只读文本：长内涵 / 计价说明要能拖选复制 -->
      <TextBox Grid.Column="1" Style="{StaticResource Tx.Sel}" Text="{Binding Text, Mode=OneWay}"
               Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" />
      <Button Grid.Column="1" Style="{StaticResource Link.Line}" Content="{Binding Text}"
              local:RelatedLink.Enable="True"
              ToolTip="点击查看"
              Visibility="{Binding IsLinkable, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DataTemplate>

  <!-- 详情卡字段块：左标签列 + 右多行值（行模板见 Line.Tpl） -->
  <DataTemplate x:Key="Block.Tpl">
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="132" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Top"
                 Margin="0,0,0,2" Foreground="{DynamicResource B.Muted}" />
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Lines}"
                    ItemTemplate="{StaticResource Line.Tpl}" />
    </Grid>
  </DataTemplate>

  <!-- 类别「使用说明」的一条：序号 + 正文（按文号汇总时正文上方带类别小标题） -->
  <DataTemplate x:Key="Usage.Item">
    <Grid Margin="0,0,0,5" local:RowMenu.Enable="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding No}" FontFamily="{StaticResource Font.Mono}"
                 FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                 Foreground="{DynamicResource B.InfoText}" Opacity="0.8" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Group}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource B.InfoText}"
                   Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" />
        <TextBox Style="{StaticResource Tx.Sel}" Text="{Binding Text, Mode=OneWay}"
                 Foreground="{DynamicResource B.Text}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- ==================================================================
       「征求意见稿」模板（前台「新项目征求意见」页专用）
       一律放在字典末尾：ResourceDictionary 里 StaticResource 前向引用必炸
       （见 README §WPF 已修缺陷），末尾位置对后续新增也最安全。
       ================================================================== -->

  <!-- 行样式：草稿底色 + 三个交互态一次写全。
       为什么不直接在页面上挂 RowStyle 触发器：DgRow 自身已有
       AlternationIndex / IsMouseOver / IsSelected 三个 Trigger，
       派生样式里再写同名 Trigger 会与之竞争，出现「鼠标悬停黄底消失」
       的割裂感。这里把四种状态统一收敛为黄系。 -->
  <Style x:Key="DgRow.Draft" TargetType="DataGridRow" BasedOn="{StaticResource DgRow}">
    <Setter Property="Background" Value="{DynamicResource B.DraftBg}" />
    <Setter Property="Foreground" Value="{DynamicResource B.DraftFg}" />
    <!-- 单行 12.5px 文本自然行高只有 ~24px，视觉太扁；给个下限让密度协调 -->
    <Setter Property="MinHeight" Value="32" />
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource B.DraftBg}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.DraftBadge}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.DraftBadge}" />
        <Setter Property="Foreground" Value="{DynamicResource B.DraftFg}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 「征求意见稿」胶囊角标（名称列行尾） -->
  <Style x:Key="DraftTag" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="7,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource B.DraftBadge}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.DraftBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="DraftTagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.DraftFg}" />
  </Style>

</ResourceDictionary>
