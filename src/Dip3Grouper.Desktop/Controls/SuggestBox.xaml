<UserControl x:Class="Dip3GrouperApp.Desktop.Controls.SuggestBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid>
    <TextBox x:Name="Input" Style="{StaticResource Tb}"
             TextChanged="OnTextChanged"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseLeftButtonDown="OnInputMouseDown"
             GotKeyboardFocus="OnGotFocus"
             LostKeyboardFocus="OnLostFocus" />

    <!-- 水印：刻意用「同模板同 Padding 的 TextBox」而不是 TextBlock。
         文字排版交给同一套文本引擎，起点 / 基线才和光标逐像素一致；
         换成 TextBlock 时提示语会比真正输入的文字左移约 12px（用户看到的就是「提示文字和光标对不上」）。 -->
    <TextBox x:Name="Ph" IsHitTestVisible="False" Text="{Binding Placeholder, ElementName=Root}">
      <TextBox.Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Tb}">
          <Setter Property="IsReadOnly" Value="True" />
          <Setter Property="IsTabStop" Value="False" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CaretBrush" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource B.Faint}" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>

    <!-- 回显：当前编码对应的名称。字段里只剩一个编码时，一眼能看出选的是哪个诊断 / 手术 -->
    <TextBlock x:Name="Echo" HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,12,0" FontSize="12" MaxWidth="180"
               TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
               Foreground="{DynamicResource B.Muted}" Visibility="Collapsed" />

    <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=Input}">
      <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}"
              BorderThickness="1" CornerRadius="10" Margin="0,4,0,8" MaxHeight="340">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                            Color="#17212e" Opacity="0.18" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4" x:Name="Scroller">
          <StackPanel>
            <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="bd" Padding="10,7" Background="Transparent" Cursor="Hand"
                        CornerRadius="6" MouseLeftButtonDown="OnItemMouseDown">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Code}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource B.Text}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13"
                                 Foreground="{DynamicResource B.Text}" VerticalAlignment="Center" />
                      <Border Style="{StaticResource Tag}"
                              Visibility="{Binding Gray, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TagText}" Text="灰码·保留原码" />
                      </Border>
                      <Border Style="{StaticResource Tag}"
                              Visibility="{Binding Linked, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TagText}" Text="联动" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding MapText}" Margin="0,3,0,0" FontSize="11.5"
                               Foreground="{DynamicResource B.Muted}"
                               Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding DipText}" Margin="0,2,0,0" FontSize="11.5"
                               Foreground="{DynamicResource B.Accent}" TextWrapping="Wrap"
                               Visibility="{Binding HasDip, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
            <TextBlock x:Name="MoreHint" Margin="10,4,10,8" FontSize="11"
                       Foreground="{DynamicResource B.Muted}" TextWrapping="Wrap"
                       Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Grid>
</UserControl>
