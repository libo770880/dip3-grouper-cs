<Window x:Class="Dip3GrouperApp.Desktop.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:admin="clr-namespace:Dip3GrouperApp.Desktop.Views.Admin"
        Title="DIP 3.0 分组器 · 后台管理"
        Width="1220" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Bg}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= 侧边栏 ================= -->
    <Border Grid.Column="0" Background="{DynamicResource B.Sidebar}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource B.SidebarHead}" Padding="16,14">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource B.LogoBox}">
              <TextBlock x:Name="TxtSideLogo" Text="DIP" Foreground="{DynamicResource B.White}"
                         FontSize="11.5" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="后台管理" Foreground="{DynamicResource B.White}" FontSize="14"
                         FontWeight="Bold" LineHeight="16" />
              <TextBlock x:Name="TxtSideAppName" Foreground="{DynamicResource B.SidebarTextFaint}"
                         FontSize="11" LineHeight="13" Text="DIP 3.0 分组器" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="TxtDataDir" Foreground="{DynamicResource B.SidebarTextFaint}"
                   FontSize="10.5" TextWrapping="Wrap" Margin="14,10,14,14" />

        <StackPanel Margin="0,12,0,0">
          <RadioButton x:Name="NavDash" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="▦   概览" IsChecked="True" Checked="OnNav" />
          <RadioButton x:Name="NavDiseases" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="▤   病种库管理" Checked="OnNav" />
          <RadioButton x:Name="NavLixiang" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="◫   立项指南" Checked="OnNav" />
          <RadioButton x:Name="NavMapping" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="⇄   映射与灰码" Checked="OnNav" />
          <RadioButton x:Name="NavDezhou" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="▩   德州物价" Checked="OnNav" />
          <RadioButton x:Name="NavVersion" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="⟲   版本管理" Checked="OnNav" />
          <RadioButton x:Name="NavAudit" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="☰   审计日志" Checked="OnNav" />
          <RadioButton x:Name="NavData" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="⇅   数据更新" Checked="OnNav" />
          <RadioButton x:Name="NavSettings" GroupName="AdminNav" Style="{StaticResource Nav.Side}"
                       Content="⚙   系统设置" Checked="OnNav" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= 右侧 ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource B.Top}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock x:Name="TxtPageTitle" Margin="20,0,0,0" VerticalAlignment="Center"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource B.Text}" Text="概览" />
          <Button x:Name="BtnClose" Style="{StaticResource WinBtn.Close}"
                  HorizontalAlignment="Right" Margin="0,0,6,0" Click="OnClose" ToolTip="关闭"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource WinIcon}"
                  Data="M 0.6 0.6 L 10.4 10.4 M 10.4 0.6 L 0.6 10.4" />
          </Button>
        </Grid>
      </Border>

      <!-- 页面容器（各页懒加载：首次进入才建数据） -->
      <Grid Grid.Row="1" x:Name="PageHost">
        <admin:AdminOverviewView x:Name="PageOverview" />
        <admin:AdminDiseasesView x:Name="PageDiseases" Visibility="Collapsed" />
        <admin:AdminLixiangView x:Name="PageLixiang" Visibility="Collapsed" />
        <admin:AdminMappingView x:Name="PageMapping" Visibility="Collapsed" />
        <admin:AdminDezhouView x:Name="PageDezhou" Visibility="Collapsed" />
        <admin:AdminVersionView x:Name="PageVersion" Visibility="Collapsed" />
        <admin:AdminAuditView x:Name="PageAudit" Visibility="Collapsed" />
        <admin:AdminDataView x:Name="PageData" Visibility="Collapsed" />
        <admin:AdminSettingsView x:Name="PageSettings" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Window>
