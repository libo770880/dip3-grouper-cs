<Window x:Class="Dip3GrouperApp.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="后台管理登录"
        Width="428" Height="504"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Border Margin="18" CornerRadius="16"
          Background="{DynamicResource B.Card}"
          BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                        Color="#0f1728" Opacity="0.28" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="132" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ 品牌头（可拖动窗口） ============ -->
      <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="{DynamicResource B.LogoBox}"
              MouseLeftButtonDown="OnHeadDrag">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0">
            <Border Width="44" Height="44" CornerRadius="12" Background="#33ffffff"
                    BorderBrush="#4dffffff" BorderThickness="1">
              <TextBlock x:Name="TxtLogo" Foreground="#ffffff" FontSize="14.5" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtAppName" Foreground="#ffffff" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="后台管理 · 请登录" Foreground="#ccffffff" FontSize="11.5" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>

          <Button Style="{StaticResource Btn.Icon}" Click="OnCancel" ToolTip="关闭"
                  Width="28" Height="28" Background="#26ffffff"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
            <TextBlock Text="✕" Foreground="#ffffff" FontSize="12" />
          </Button>
        </Grid>
      </Border>

      <!-- ============ 表单 ============ -->
      <StackPanel Grid.Row="1" Margin="30,24,30,20">
        <TextBlock Text="登录账号" FontSize="12.5" Foreground="{DynamicResource B.Muted}" />
        <TextBox x:Name="TxtUser" Style="{StaticResource Tb}" Margin="0,7,0,0"
                 Height="38" FontSize="13.5" PreviewKeyDown="OnFieldKey" />
        <TextBlock Text="登录密码" FontSize="12.5" Margin="0,16,0,0"
                   Foreground="{DynamicResource B.Muted}" />
        <!-- 密码框显式关闭输入法：中文输入法开着时回车会先被 IME 拿去做"上屏"，
             WPF 就再也收不到 Key.Enter（点了登录却敲回车没反应就是这么来的） -->
        <PasswordBox x:Name="TxtPass" Style="{StaticResource Pwb}" Margin="0,7,0,0"
                     Height="38" FontSize="13.5"
                     InputMethod.IsInputMethodEnabled="False" PreviewKeyDown="OnFieldKey" />

        <TextBlock x:Name="TxtError" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Danger}" Visibility="Collapsed" />

        <TextBlock x:Name="TxtHint" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Muted}" LineHeight="18" />
      </StackPanel>

      <!-- ============ 底部 ============ -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Border}"
              Padding="30,16">
        <!-- IsDefault：WPF 原生默认按钮，回车落在窗口任何位置都能触发（第 3 条回车通道） -->
        <Button x:Name="BtnLogin" Style="{StaticResource Btn.Primary}" Content="登 录"
                Height="40" FontSize="14" IsDefault="True" Click="OnLogin" />
      </Border>
    </Grid>
  </Border>
</Window>
