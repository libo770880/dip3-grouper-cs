<UserControl x:Class="Dip3GrouperApp.Desktop.ToolPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dip3GrouperApp.Desktop"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <UserControl.Resources>
    <!-- 工具卡片：整块可点，悬停变淡蓝描边（不为一张卡单独写一套模板文件） -->
    <Style x:Key="ToolCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource B.Card}"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="12,11">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="ToolDesc" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource B.Card}">

    <!-- ①  工具栏首页：三张在用卡片（病理 / 物耗 / 物价 AI）+ 一个预留位 -->
    <Grid x:Name="HomeView">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,11,12,11" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Margin="0,0,11,0"
                  Background="{DynamicResource B.Accent}" VerticalAlignment="Center">
            <TextBlock Text="工" Foreground="{DynamicResource B.White}" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="工具栏" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource B.Text}" />
            <TextBlock x:Name="TxtSub" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource B.Muted}" />
          </StackPanel>

          <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Click="OnClose" ToolTip="收起（Esc）"
                  Width="26" Height="26" VerticalAlignment="Center">
            <TextBlock Text="✕" FontSize="11.5" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
        <StackPanel>
          <TextBlock Text="工具" Style="{StaticResource Label}" Margin="0,0,0,9" />

          <!-- 2×2：病理 / 物耗 / 物价 AI 三格在用，右下留一格 —— 以后新增工具直接替换它 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnPathology" Style="{StaticResource ToolCard}"
                    Margin="0,0,5,10" MinHeight="66" Click="OnPickPathology"
                    ToolTip="按疾病系统查标本档位，按蜡块算二级/三级收费（Ctrl+G）">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="{DynamicResource B.Accent}" VerticalAlignment="Center">
                  <TextBlock Text="病" Foreground="{DynamicResource B.White}" FontSize="15" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="病理开具指引" Style="{StaticResource ToolName}" />
                  <TextBlock x:Name="TxtPathDesc" Style="{StaticResource ToolDesc}"
                             Text="按标本算蜡块 · 按蜡块算钱（二级 / 三级）" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="19" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.Faint}" />
              </Grid>
            </Button>

            <Button Grid.Row="0" Grid.Column="1" x:Name="BtnWuhao" Style="{StaticResource ToolCard}"
                    Margin="5,0,0,10" MinHeight="66" Click="OnPickWuhao"
                    ToolTip="查一个耗材能不能另收：基本物耗清单 / 边界清单 / 条款原文">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="{DynamicResource B.Warn}" VerticalAlignment="Center">
                  <TextBlock Text="耗" Foreground="{DynamicResource B.White}" FontSize="15" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="基本物耗指引" Style="{StaticResource ToolName}" />
                  <TextBlock x:Name="TxtWuhaoDesc" Style="{StaticResource ToolDesc}"
                             Text="哪些含在项目价内不能收 · 哪些可零差率另收" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="19" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.Faint}" />
              </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="0" x:Name="BtnPriceAi" Style="{StaticResource ToolCard}"
                    Margin="0,0,5,0" MinHeight="66" Click="OnPickPriceAi"
                    ToolTip="按立项指南检索条文后交给自己配置的模型解读，支持咨询与地区设置">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="{DynamicResource B.Accent}" VerticalAlignment="Center">
                  <TextBlock Text="AI" Foreground="{DynamicResource B.White}" FontSize="12" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="物价解读 AI" Style="{StaticResource ToolName}" />
                  <TextBlock x:Name="TxtPriceAiDesc" Style="{StaticResource ToolDesc}"
                             Text="按立项指南精准解读 · 可咨询 · 可设置地区" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="19" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.Faint}" />
              </Grid>
            </Button>

            <Grid Grid.Row="1" Grid.Column="1" MinHeight="66" Margin="5,0,0,0">
              <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent" StrokeThickness="1"
                         StrokeDashArray="3 3" Stroke="{DynamicResource B.BorderStrong}" />
              <StackPanel Margin="13,11" VerticalAlignment="Center">
                <TextBlock Text="预留工具位" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Muted}" />
                <TextBlock Text="后续工具加在这里" FontSize="10.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource B.Faint}" />
              </StackPanel>
            </Grid>
          </Grid>

          <TextBlock Margin="0,16,0,0" FontSize="11" TextWrapping="Wrap" LineHeight="18"
                     Foreground="{DynamicResource B.Faint}"
                     Text="工具栏只放开单时的速查 / 计价小工具，不占顶部导航；新增工具加进这一栏，不影响已在用的病理开具指引。" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ②  病理开具指引（原 GuidePanel，头部带「‹ 工具栏」返回） -->
    <Grid x:Name="GuideView" Visibility="Collapsed">
      <local:GuidePanel x:Name="Guide" />
    </Grid>

    <!-- ③  基本物耗指引（判定 / 清单 / 边界 / 条款） -->
    <Grid x:Name="WuhaoView" Visibility="Collapsed">
      <local:WuhaoPanel x:Name="Wuhao" />
    </Grid>

    <!-- ④  物价解读 AI（本地检索证据 + 用户自配模型，配置只留本机） -->
    <Grid x:Name="PriceAiView" Visibility="Collapsed">
      <local:PriceAiPanel x:Name="PriceAi" />
    </Grid>
  </Grid>
</UserControl>
