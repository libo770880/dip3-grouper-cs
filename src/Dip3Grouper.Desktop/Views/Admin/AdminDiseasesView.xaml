<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminDiseasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题 -->
      <Grid Grid.Row="0" Margin="2,0,0,10">
        <TextBlock Style="{StaticResource PageTitle}" Text="病种库管理" VerticalAlignment="Center" />
        <TextBlock x:Name="TxtMeta" Style="{StaticResource Desc}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
      </Grid>

      <!-- 区段胶囊 -->
      <WrapPanel Grid.Row="1" x:Name="TabsPanel" Margin="0,0,0,10" />

      <!-- 搜索 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBox x:Name="QueryBox" Style="{StaticResource Tb}" Width="360"
                 PreviewKeyDown="OnQueryKey" />
        <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="8,0,0,0" Click="OnSearch" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Desc}" Margin="14,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- 工具条 -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
        <Button Style="{StaticResource Btn.Mini.Primary}" Content="整库导入" Click="OnImportConfig"
                ToolTip="用一整份病种库 Excel 覆盖 config/dip3-config.json（旧文件自动备份）" />
        <Button Style="{StaticResource Btn.Mini}" Content="区段导入" Margin="6,0,0,0"
                Click="OnImportSection" ToolTip="仅导入当前区段（按表头匹配列）" />
        <Button Style="{StaticResource Btn.Mini}" Content="下载模板" Margin="6,0,0,0"
                Click="OnTemplate" ToolTip="导出当前区段的 Excel 模板（含示例行）" />
        <Border Width="1" Background="{DynamicResource B.Border}" Margin="12,3" />
        <Button Style="{StaticResource Btn.Mini.Primary}" Content="新 增" Click="OnAdd" />
        <Button Style="{StaticResource Btn.Mini}" Content="编 辑" Margin="6,0,0,0" Click="OnEdit" />
        <Button Style="{StaticResource Btn.Mini.Danger}" Content="删 除" Margin="6,0,0,0" Click="OnDelete" />
      </StackPanel>

      <!-- 表格（双击行即编辑） -->
      <DataGrid Grid.Row="4" x:Name="Grid" Style="{StaticResource Dg.ReadOnly}"
                MouseDoubleClick="OnRowDoubleClick" />

      <!-- 分页 -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Button x:Name="BtnPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                FontSize="12.5" Content="上一页" Click="OnPrev" />
        <TextBlock x:Name="PageInfo" Style="{StaticResource Desc}" Margin="14,0"
                   VerticalAlignment="Center" />
        <Button x:Name="BtnNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                FontSize="12.5" Content="下一页" Click="OnNext" />
      </StackPanel>
    </Grid>
</UserControl>
