<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="2,0,0,14">
        <TextBlock Style="{StaticResource PageTitle}" Text="概览" VerticalAlignment="Center" />
        <TextBlock x:Name="TxtRoot" Style="{StaticResource Desc}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 六张统计卡（三列两行） -->
          <UniformGrid Columns="3" x:Name="CardHost" />

          <!-- 区段条数明细 -->
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Style="{StaticResource SecTitle}" Text="病种库各区段条数" Margin="0,0,0,10" />
              <ItemsControl x:Name="SectionChips">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource B.SoftBg}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{DynamicResource B.Text}" />
                        <TextBlock Text="{Binding Total}" FontSize="12" FontWeight="Bold"
                                   Margin="7,0,0,0" Foreground="{DynamicResource B.Accent}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 立项指南区段 -->
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Style="{StaticResource SecTitle}" Text="立项指南各区段条数" Margin="0,0,0,10" />
              <ItemsControl x:Name="LixiangChips">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource B.SoftBg}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{DynamicResource B.Text}" />
                        <TextBlock Text="{Binding Total}" FontSize="12" FontWeight="Bold"
                                   Margin="7,0,0,0" Foreground="{DynamicResource B.Ok}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 快捷操作 -->
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Style="{StaticResource SecTitle}" Text="快捷操作" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Ghost}" Content="重新载入配置"
                        Click="OnReloadConfig" />
                <Button Style="{StaticResource Btn.Ghost}" Content="刷新统计" Margin="8,0,0,0"
                        Click="OnRefresh" />
                <Button Style="{StaticResource Btn.Ghost}" Content="打开数据目录" Margin="8,0,0,0"
                        Click="OnOpenDataDir" />
              </StackPanel>
              <TextBlock x:Name="TxtStatus" Style="{StaticResource Desc}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
