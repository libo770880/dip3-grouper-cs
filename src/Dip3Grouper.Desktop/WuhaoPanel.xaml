<UserControl x:Class="Dip3GrouperApp.Desktop.WuhaoPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <UserControl.Resources>
    <Style x:Key="WTab" TargetType="RadioButton" BasedOn="{StaticResource Pill}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource B.Card}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= 头部 ================= -->
    <Border Grid.Row="0" Padding="16,11,12,11" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource Btn.Icon}"
                Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"
                Visibility="Collapsed" Click="OnBack" ToolTip="返回工具栏">
          <TextBlock Text="‹" FontSize="17" Margin="0,-2,0,0" />
        </Button>

        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,11,0"
                Background="{DynamicResource B.Warn}" VerticalAlignment="Center">
          <TextBlock Text="耗" Foreground="{DynamicResource B.White}" FontSize="14" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="基本物耗指引" FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource B.Text}" />
          <TextBlock x:Name="TxtSub" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource B.Muted}" />
        </StackPanel>

        <Button x:Name="BtnMaint" Grid.Column="2" Style="{StaticResource Btn.Icon}"
                Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"
                Click="OnMaintToggle" ToolTip="手工维护本机清单（不改基础库，只写 data/wuhao.user.json）">
          <TextBlock Text="✎" FontSize="14" />
        </Button>

        <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Click="OnClose" ToolTip="收起（Esc）"
                Width="26" Height="26" VerticalAlignment="Center">
          <TextBlock Text="✕" FontSize="11.5" />
        </Button>
      </Grid>
    </Border>

    <!-- ================= 四个页签 ================= -->
    <Border Grid.Row="1" Padding="16,8,16,8" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabJudge" GroupName="WTab" Style="{StaticResource WTab}" Content="判定"
                     IsChecked="True" Checked="OnTab" Tag="judge" />
        <RadioButton x:Name="TabBasic" GroupName="WTab" Style="{StaticResource WTab}" Content="不可收费"
                     Checked="OnTab" Tag="basic" />
        <RadioButton x:Name="TabCharge" GroupName="WTab" Style="{StaticResource WTab}" Content="可收费"
                     Checked="OnTab" Tag="charge" />
        <RadioButton x:Name="TabRule" GroupName="WTab" Style="{StaticResource WTab}" Content="口径依据"
                     Checked="OnTab" Tag="rule" />
        <TextBlock x:Name="TxtStatus" Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- ================= ① 判定 ================= -->
    <Grid x:Name="ViewJudge" Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,12,16,11" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <StackPanel>
          <Grid>
            <TextBox x:Name="TxtQuery" Style="{StaticResource Tb}" Height="34" FontSize="14"
                     TextChanged="OnQueryText" KeyDown="OnQueryKey"
                     ToolTip="输入耗材名称，边打边判（如：纱布 / 输液器 / 钢板 / 留置针）" />
            <TextBlock x:Name="TxtHint" Text="输入耗材名称，如：纱布、一次性输液器、钢板、耦合剂"
                       FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource B.Faint}" IsHitTestVisible="False" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
            <TextBlock Text="常用" Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Style="{StaticResource Chip}" Content="纱布" Tag="纱布" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="输液器" Tag="一次性输液器" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="钢板" Tag="钢板" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="耦合剂" Tag="耦合剂" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="留置针" Tag="留置针" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="玻片" Tag="玻片" Click="OnChip" />
            <Button Style="{StaticResource Chip}" Content="免疫组化试剂" Tag="免疫组化抗体" Click="OnChip" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,10">
        <StackPanel>
          <Border x:Name="ResultCard" CornerRadius="10" Padding="16,14" BorderThickness="1"
                  Background="{DynamicResource B.InfoBg}" BorderBrush="{DynamicResource B.InfoBorder}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Badge" CornerRadius="6" Padding="8,3" Background="{DynamicResource B.Danger}"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="TxtBadge" Text="不可另收" FontSize="11.5" FontWeight="Bold"
                             Foreground="{DynamicResource B.White}" />
                </Border>
                <TextBlock x:Name="TxtVerdict" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource B.Text}" />
              </StackPanel>

              <TextBlock x:Name="TxtBasis" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                         Margin="0,10,0,0" Foreground="{DynamicResource B.InfoText}" />
              <TextBlock x:Name="TxtNote" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                         Margin="0,6,0,0" Foreground="{DynamicResource B.Muted}" />

              <Border x:Name="NearBox" Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                      Background="{DynamicResource B.SoftBg}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="清单里的相近条目" Style="{StaticResource CardTitle}" Margin="0,0,0,5" />
                  <ItemsControl x:Name="NearList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontSize="12" Margin="0,1" Foreground="{DynamicResource B.Text}">
                          <Run Text="· " Foreground="{DynamicResource B.Faint}" />
                          <Run Text="{Binding Name}" FontWeight="SemiBold" />
                          <Run Text="{Binding CatText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource B.Muted}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TxtJudgeTip" FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                     Margin="2,12,2,0" Foreground="{DynamicResource B.Faint}"
                     Text="口径来源：36 类立项指南「使用说明」的基本物耗条款 + 德医保发〔2026〕25 号通知正文。判定只回答「能不能另收」，具体金额按实际采购价零差率。" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="16,8,16,9" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
        <TextBlock Text="三步判定：① 在本科室项目所属类别的「基本物耗」清单里 → 不能收；② 不在 → 看原项目「除外内容」；③ 还没答案 → 查省/市「可另收费一次性材料目录」与本院耗材编码。"
                   FontSize="11" TextWrapping="Wrap" LineHeight="17" Foreground="{DynamicResource B.Muted}" />
      </Border>
    </Grid>

    <!-- ================= ② 不可收费（基本物耗清单） ================= -->
    <Grid x:Name="ViewBasic" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,9,16,9" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="0,0,8,0">
            <TextBox x:Name="TxtBasicQuery" Style="{StaticResource Tb}" Height="30" TextChanged="OnBasicQuery"
                     ToolTip="在基本物耗清单里搜名称 / 别名 / 说明" />
            <TextBlock x:Name="TxtBasicHint" Text="在清单里搜：纱布、棉签、引流、试剂…"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource B.Faint}" IsHitTestVisible="False" />
          </Grid>
          <TextBlock x:Name="TxtBasicCount" Grid.Column="1" Style="{StaticResource Desc}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16,11,16,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="172" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="9" Background="{DynamicResource B.SoftBg}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Margin="0,0,10,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="归类" Style="{StaticResource Label}" Margin="11,9,11,5" />
            <ListBox x:Name="GroupList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnGroupChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Width="146" Margin="0,1">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,22,0" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Count}" FontSize="10.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource B.Muted}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <DataGrid x:Name="ItemGrid" Grid.Column="1" Style="{StaticResource Dg.ReadOnly}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="OnItemChanged" MouseDoubleClick="OnItemDoubleClick"
                  PreviewKeyDown="OnItemKey" RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="耗材" Binding="{Binding Name}" Width="196" />
            <DataGridTextColumn Header="覆盖" Binding="{Binding CountText}" Width="72" />
            <DataGridTemplateColumn Header="说明" Width="*" MinWidth="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12"
                             ToolTip="{Binding Note}"
                             VerticalAlignment="Center" Margin="0,2" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Border Grid.Row="2" Padding="16,9,16,10" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
        <StackPanel>
          <TextBlock x:Name="TxtItemName" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" />
          <!-- 双击某条 → 判定页；这里直接带出条款原文，不用再去「口径依据」里翻 -->
          <ScrollViewer MaxHeight="102" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0">
            <TextBlock x:Name="TxtItemBasis" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{DynamicResource B.Muted}" />
          </ScrollViewer>
          <!-- 搜不到 ≠ 没收录：留置针这类在边界清单里，给一条出路，别让人以为工具不认识 -->
          <Button x:Name="BtnEdgeHint" Style="{StaticResource Btn.Link}" Visibility="Collapsed"
                  HorizontalAlignment="Left" Margin="0,3,0,0" Click="OnGotoEdge">
            <TextBlock x:Name="TxtEdgeHint" FontSize="11" Text="在「可收费」页的边界清单里有 1 条 →" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= ③ 可收费（边界清单） ================= -->
    <Grid x:Name="ViewCharge" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,11,16,10" Background="{DynamicResource B.WarnBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock Text="25 号文第一条：除「使用说明」中纳入基本物耗的一次性耗材外，映射原价格项目的除外内容与现行可另收费的一次性材料目录继续执行。"
                     FontSize="11.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource B.WarnText}" />
          <TextBlock Text="各类指南：除基本物耗以外的其他耗材，按照实际采购价格零差率销售。"
                     FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"
                     Foreground="{DynamicResource B.WarnText}" Opacity="0.86" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Padding="16,8,16,8" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock x:Name="TxtEdgeCount" Style="{StaticResource Desc}" VerticalAlignment="Center" />
          <ComboBox x:Name="EdgeSel" HorizontalAlignment="Right" Style="{StaticResource Cb}" Width="150"
                    Height="28" SelectionChanged="OnEdgeFilter" />
        </Grid>
      </Border>

      <DataGrid x:Name="EdgeGrid" Grid.Row="2" Margin="16,10,16,10" Style="{StaticResource Dg.ReadOnly}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="OnEdgeChanged" RowHeaderWidth="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="耗材 / 场景" Binding="{Binding Name}" Width="238" />
          <DataGridTextColumn Header="类别" Binding="{Binding Cat}" Width="82" />
          <DataGridTemplateColumn Header="结论" Width="108">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border x:Name="Vb" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left"
                        Background="{DynamicResource B.SoftBg}">
                  <TextBlock x:Name="Vt" Text="{Binding Verdict}" FontSize="11.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Muted}" />
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Verdict}" Value="可另收">
                    <Setter TargetName="Vb" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Setter TargetName="Vt" Property="Foreground" Value="{DynamicResource B.Accent}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="可另收（减收）">
                    <Setter TargetName="Vb" Property="Background" Value="{DynamicResource B.DeductBg}" />
                    <Setter TargetName="Vt" Property="Foreground" Value="{DynamicResource B.Deduct}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="不可另收">
                    <Setter TargetName="Vb" Property="Background" Value="{DynamicResource B.DangerSoft}" />
                    <Setter TargetName="Vt" Property="Foreground" Value="{DynamicResource B.Danger}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Verdict}" Value="需核对">
                    <Setter TargetName="Vb" Property="Background" Value="{DynamicResource B.WarnBg}" />
                    <Setter TargetName="Vt" Property="Foreground" Value="{DynamicResource B.WarnText}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="依据 / 提示" Width="*" MinWidth="240">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Basis}" TextWrapping="Wrap" FontSize="12" LineHeight="17" />
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" LineHeight="16"
                             Margin="0,1,0,0" Foreground="{DynamicResource B.Muted}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ================= ④ 口径依据 ================= -->
    <Grid x:Name="ViewRule" Grid.Row="2" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,12">
        <StackPanel>
          <TextBlock Text="判断口径" Style="{StaticResource Label}" Margin="0,0,0,7" />
          <ItemsControl x:Name="RuleList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,7" Padding="11,9" CornerRadius="8"
                        Background="{DynamicResource B.SoftBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding No}" FontSize="11.5" FontWeight="Bold"
                                 Foreground="{DynamicResource B.Accent}" Margin="0,0,7,0" />
                      <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource B.Text}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                               Margin="0,4,0,0" Foreground="{DynamicResource B.Muted}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="TxtSrcTitle" Style="{StaticResource Label}" Margin="0,12,0,7" />
          <ItemsControl x:Name="SourceList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="11,8" CornerRadius="8"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{Binding Cat}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}" />
                    <TextBlock Text="{Binding Clause}" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                               Margin="0,3,0,0" Foreground="{DynamicResource B.Muted}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="TxtFoot" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"
                     Margin="0,10,0,4" Foreground="{DynamicResource B.Faint}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================= ⑤ 手工维护（本机覆盖层） ================= -->
    <Grid x:Name="ViewMaint" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,11,12,11" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock Text="手工维护" FontSize="13.5" FontWeight="Bold"
                     Foreground="{DynamicResource B.Text}" />
          <TextBlock x:Name="TxtMaintSub" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.Muted}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Padding="16,8,16,8" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabMaintItem" GroupName="MT" Style="{StaticResource WTab}"
                       Content="清单条目" IsChecked="True" Checked="OnMaintTab" Tag="item" />
          <RadioButton x:Name="TabMaintEdge" GroupName="MT" Style="{StaticResource WTab}"
                       Content="边界条目" Checked="OnMaintTab" Tag="edge" />
          <TextBlock x:Name="TxtMaintCount" Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <!-- 别名体检：只读检查「自名别名冗余 / 跨条目撞名 / 别名互撞 / 同名条目 / 撞边界条目」。
               真实冲突 >0 时标红；自名别名只是冗余，不影响判定，不自动改数据。 -->
          <Button x:Name="BtnAliasAudit" Style="{StaticResource Chip}" Click="OnAliasAudit"
                  Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                  ToolTip="别名体检：只读检查冗余别名与跨条目撞名，点击看明细" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="16,10,16,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：维护表格（清单 / 边界） -->
        <DataGrid x:Name="MaintGrid" Grid.Column="0" Margin="0,0,10,0"
                  Style="{StaticResource Dg.ReadOnly}" MaxHeight="560"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="OnMaintSelection" RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
            <DataGridTemplateColumn Header="结论" Width="78">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding VerdictText}" FontSize="11" Margin="0,0,4,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="覆盖" Width="62">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CoverText}" FontSize="10.5" Margin="0,0,4,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource B.Muted}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- 右：选中条目编辑面板 -->
        <Border Grid.Column="1" CornerRadius="9" Background="{DynamicResource B.SoftBg}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="11,11">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock x:Name="TxtEditTitle" Text="选中左侧条目后可修改" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource B.Text}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,9,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource B.Muted}" />
                <TextBox x:Name="EdtEName" Grid.Column="1" Style="{StaticResource Tb}" Height="30"
                         TextChanged="OnMaintField" />
                <StackPanel Grid.Column="2">
                  <Button Style="{StaticResource Chip}" Content="删除" Click="OnMaintDelete" Width="64" />
                </StackPanel>
              </Grid>
              <StackPanel x:Name="PanelMGroup" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="分组" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                             Foreground="{DynamicResource B.Muted}" />
                  <ComboBox x:Name="CbMGroup" Grid.Column="1" Style="{StaticResource Cb}" Height="28"
                            DisplayMemberPath="Name" SelectedValuePath="Id"
                            SelectionChanged="OnMaintField" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,0,0">
                <!-- 清单条目字段：分组（上面）+ 别名 + 说明 -->
                <StackPanel x:Name="PanelMItem">
                  <TextBlock Text="别名" FontSize="11" Margin="0,0,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBox x:Name="EdtMAlias" Style="{StaticResource Tb}" Height="40" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" AcceptsReturn="True"
                           TextChanged="OnMaintField"
                           ToolTip="多个别名用顿号、分号、逗号分隔；判定时逐一匹配" />
                  <TextBlock Text="说明" FontSize="11" Margin="0,8,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBox x:Name="EdtMNote" Style="{StaticResource Tb}" Height="48" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" AcceptsReturn="True"
                           TextChanged="OnMaintField"
                           ToolTip="在「不可收费」页清单里看到的说明文字" />
                </StackPanel>

                <!-- 边界条目字段：结论 / 类别 / 依据 / 提示 -->
                <StackPanel x:Name="PanelMEdge" Visibility="Collapsed">
                  <TextBlock Text="结论" FontSize="11" Margin="0,0,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <ComboBox x:Name="CbEVerdict" Style="{StaticResource Cb}" Height="28" Width="135"
                            SelectionChanged="OnMaintField" />
                  <TextBlock Text="类别" FontSize="11" Margin="0,8,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBox x:Name="EdtECat" Style="{StaticResource Tb}" Height="28"
                           TextChanged="OnMaintField" />
                  <TextBlock Text="依据" FontSize="11" Margin="0,8,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBox x:Name="EdtEBasis" Style="{StaticResource Tb}" Height="56" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" AcceptsReturn="True"
                           TextChanged="OnMaintField" />
                  <TextBlock Text="提示" FontSize="11" Margin="0,8,0,2"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBox x:Name="EdtENote" Style="{StaticResource Tb}" Height="36" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" AcceptsReturn="True"
                           TextChanged="OnMaintField" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Padding="16,9,16,10" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Chip}" Content="新增空白条目" Click="OnMaintNew" />
          <Button Style="{StaticResource Chip}" Content="撤销编辑" Click="OnMaintUndo" Margin="6,0,0,0" />
          <Button Style="{StaticResource Chip}" Content="重置全部改动" Click="OnMaintReset" Margin="6,0,0,0" />
          <!-- 保存是这一页唯一的主操作，必须实心蓝底：Chip 的模板把 Background 写死成透明，
               套在它上面会变成「白字 + 透明底」，按钮等于看不见（Chip 模板不绑定 Background）。 -->
          <Button x:Name="BtnMaintSave" Style="{StaticResource Btn.Primary}" Content="保存到本机"
                  Click="OnMaintSave" Height="24" MinHeight="24" Padding="14,0"
                  FontSize="11.5" Margin="6,0,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
