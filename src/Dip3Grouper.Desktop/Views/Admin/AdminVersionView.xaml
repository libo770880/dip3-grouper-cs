<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminVersionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="版本管理" VerticalAlignment="Center" />
      <TextBlock x:Name="TxtHead" Style="{StaticResource Desc}" VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 Text="病种库每次改动前后都会自动留档，可随时比对与回滚" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

        <!-- ============ 卡 1：当前状态与新建 ============ -->
        <Border Style="{StaticResource Card}" Padding="18,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SecTitle}" Text="当前病种库" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="规模" />
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCurrent" FontSize="12.5"
                         Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}"
                         Text="指纹" Margin="0,8,0,0" />
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFingerprint" Margin="0,8,0,0"
                         Style="{StaticResource Mono}" FontSize="12"
                         Foreground="{DynamicResource B.Muted}" TextWrapping="Wrap" />

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}"
                         Text="备注" Margin="0,8,0,0" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtNote" Style="{StaticResource Tb}"
                       Margin="0,8,0,0" MaxWidth="520"
                       ToolTip="新建快照时记录一句说明，例如「2026 版病种库定稿」" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnCreate" Style="{StaticResource Btn.Primary}" Content="新建版本快照"
                      Click="OnCreate" />
              <Button x:Name="BtnCompareCur" Style="{StaticResource Btn.Ghost}" Content="与当前比较"
                      Margin="8,0,0,0" Click="OnCompareCurrent" />
              <Button x:Name="BtnRefresh" Style="{StaticResource Btn.Ghost}" Content="刷新"
                      Margin="8,0,0,0" Click="OnRefresh" />
              <Button x:Name="BtnOpenDir" Style="{StaticResource Btn.Ghost}" Content="打开版本目录"
                      Margin="8,0,0,0" Click="OnOpenDir" />
              <TextBlock x:Name="TxtStatus" Style="{StaticResource Desc}" Margin="14,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============ 卡 2：版本列表 ============ -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SecTitle}" Text="历史版本" />
            <TextBlock Style="{StaticResource Desc}" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="选中一行即可与「当前」或「上一版本」比对；回滚会把当时那一版原样写回，回滚前的状态同样会被留档。" />

            <DataGrid x:Name="Grid" Style="{StaticResource Dg.ReadOnly}" MinHeight="180" MaxHeight="300"
                      SelectionMode="Single" SelectionChanged="OnSelect"
                      HeadersVisibility="Column" RowHeight="32">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="时间" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding AtText}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="类型" Width="58">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding KindText}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="来源 / 备注" Width="230">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Title}"
                                             TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="账号" Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding User}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="规模" Width="160">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding CountsText}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="大小" Width="76">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding SizeText}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="指纹" Width="88">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding ShortHash}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnPrev" Style="{StaticResource Btn.Ghost}" Content="与上一版本比较"
                      Click="OnComparePrev" />
              <Button x:Name="BtnRestore" Style="{StaticResource Btn.Ghost}" Content="回滚到选中版本"
                      Margin="8,0,0,0" Click="OnRestore" />
              <Button x:Name="BtnDelete" Style="{StaticResource Btn.Mini.Danger}" Content="删除版本"
                      Margin="8,0,0,0" Click="OnDelete" />
              <Button x:Name="BtnExport" Style="{StaticResource Btn.Ghost}" Content="导出差异报告…"
                      Margin="8,0,0,0" Click="OnExport" />
              <TextBlock x:Name="TxtListStatus" Style="{StaticResource Desc}" Margin="14,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============ 卡 3：差异明细 ============ -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,14">
          <StackPanel>
            <TextBlock Style="{StaticResource SecTitle}" Text="差异明细" />
            <TextBlock x:Name="TxtDiffHead" Style="{StaticResource Desc}" Margin="0,2,0,10"
                       TextWrapping="Wrap"
                       Text="在上方选中一个版本，再点「与当前比较」或「与上一版本比较」。" />

            <DataGrid x:Name="GridDiff" Style="{StaticResource Dg.ReadOnly}" MinHeight="120" MaxHeight="320"
                      HeadersVisibility="Column" RowHeight="NaN">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="区段" Width="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Label}"
                                             VerticalAlignment="Top" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="数量" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding CountText}"
                                             VerticalAlignment="Top" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="变化" Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Summary}"
                                             VerticalAlignment="Top" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="明细" Width="610">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding SampleText}"
                                             TextWrapping="Wrap" VerticalAlignment="Top" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
