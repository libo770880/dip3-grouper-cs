<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 标题 -->
      <Grid Grid.Row="0" Margin="2,0,0,12">
        <TextBlock Style="{StaticResource PageTitle}" Text="映射与灰码" VerticalAlignment="Center" />
        <TextBlock x:Name="TxtMeta" Style="{StaticResource Desc}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
      </Grid>

      <!-- ==================== 映射表 ==================== -->
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <TextBox x:Name="MapQuery" Style="{StaticResource Tb}" Width="330"
                   PreviewKeyDown="OnMapQueryKey" />
          <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="8,0,0,0"
                  Click="OnMapSearch" />
          <ComboBox x:Name="GrayFilter" Style="{StaticResource Cb}" Width="150" Margin="8,0,0,0"
                    SelectionChanged="OnGrayFilterChanged">
            <ComboBoxItem Content="全部记录" Tag="" IsSelected="True" />
            <ComboBoxItem Content="仅灰码" Tag="1" />
            <ComboBoxItem Content="非灰码" Tag="0" />
          </ComboBox>
          <TextBlock x:Name="MapStatus" Style="{StaticResource Desc}" Margin="14,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Style="{StaticResource Btn.Mini.Primary}" Content="导入映射表" Click="OnMapImport"
                  ToolTip="支持 xlsx（表头需含编码列；整行填充色按灰码识别）" />
          <Border Width="1" Background="{DynamicResource B.Border}" Margin="12,3" />
          <Button Style="{StaticResource Btn.Mini.Primary}" Content="新 增" Click="OnMapAdd" />
          <Button Style="{StaticResource Btn.Mini}" Content="编 辑" Margin="6,0,0,0" Click="OnMapEdit" />
          <Button Style="{StaticResource Btn.Mini.Danger}" Content="删 除" Margin="6,0,0,0"
                  Click="OnMapDelete" />
          <TextBlock Style="{StaticResource Desc}" VerticalAlignment="Center" Margin="14,0,0,0"
                     Text="提示：勾选「灰码」即标记该编码不映射医保编码" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="MGrid" Style="{StaticResource Dg}" MouseDoubleClick="OnMapDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="灰码" Width="58">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox Style="{StaticResource Cbx}" IsChecked="{Binding Gray, Mode=OneWay}"
                            HorizontalAlignment="Center" Click="OnGrayToggle" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ICD-10 编码" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding Code}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="诊断名称" Width="240">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Name}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="医保编码" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding InsCode}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="医保名称" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding InsName}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="备注" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Note}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Button x:Name="MapPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                  FontSize="12.5" Content="上一页" Click="OnMapPrev" />
          <TextBlock x:Name="MapPageInfo" Style="{StaticResource Desc}" Margin="14,0"
                     VerticalAlignment="Center" />
          <Button x:Name="MapNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                  FontSize="12.5" Content="下一页" Click="OnMapNext" />
        </StackPanel>
      </Grid>
    </Grid>
</UserControl>
