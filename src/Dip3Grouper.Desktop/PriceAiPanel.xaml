<UserControl x:Class="Dip3GrouperApp.Desktop.PriceAiPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <UserControl.Resources>
    <!-- 快捷提问胶囊：与物耗面板同一套扁平样式，不引入新模板文件 -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Foreground" Value="{DynamicResource B.Muted}" />
    </Style>
    <Style x:Key="FieldNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource B.Faint}" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource B.Card}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- 0 头部 -->
      <RowDefinition Height="Auto" />  <!-- 1 状态条 -->
      <RowDefinition Height="*" />     <!-- 2 对话区 -->
      <RowDefinition Height="Auto" />  <!-- 3 引用条 -->
      <RowDefinition Height="Auto" />  <!-- 4 引用详情（折叠） -->
      <RowDefinition Height="Auto" />  <!-- 5 输入区 -->
    </Grid.RowDefinitions>

    <!-- ================= 0 头部 ================= -->
    <Border Grid.Row="0" Padding="16,11,12,11" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource Btn.Icon}"
                Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"
                Visibility="Collapsed" Click="OnBack" ToolTip="返回工具栏">
          <TextBlock Text="‹" FontSize="17" Margin="0,-2,0,0" />
        </Button>

        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,11,0"
                Background="{DynamicResource B.Accent}" VerticalAlignment="Center">
          <TextBlock Text="AI" Foreground="{DynamicResource B.White}" FontSize="12" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="物价解读 AI" FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource B.Text}" />
          <TextBlock x:Name="TxtSub" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource B.Muted}" />
        </StackPanel>

        <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Click="OnSettingsToggle"
                Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"
                ToolTip="模型 API 与地区设置（配置只保存在本机）">
          <TextBlock Text="⚙" FontSize="14" />
        </Button>

        <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Click="OnClose" ToolTip="收起（Esc）"
                Width="26" Height="26" VerticalAlignment="Center">
          <TextBlock Text="✕" FontSize="11.5" />
        </Button>
      </Grid>
    </Border>

    <!-- ================= 1 状态条（地区 / 模型 / 操作） ================= -->
    <Border Grid.Row="1" Padding="14,7,14,7" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="地区" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0"
                   Foreground="{DynamicResource B.Muted}" />
        <ComboBox x:Name="CbRegion" Grid.Column="1" Width="146" Style="{StaticResource Cb}"
                  SelectionChanged="OnRegionPick" ToolTip="切换解读适用地区；可在设置里填写任意地区" />
        <TextBlock x:Name="TxtModel" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                   Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource B.Muted}" />
        <Button Grid.Column="3" Style="{StaticResource Btn.Mini}" Content="测试连接"
                Click="OnTest" Margin="0,0,6,0" ToolTip="向当前模型发一条固定问句，核对地址 / 密钥 / 模型名" />
        <Button Grid.Column="4" Style="{StaticResource Btn.Mini}" Content="新对话"
                Click="OnNewChat" ToolTip="清空当前会话（不影响本机配置与资料库）" />
      </Grid>
    </Border>

    <!-- ================= 2 对话区 ================= -->
    <ScrollViewer x:Name="MsgScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,8">
      <StackPanel x:Name="MsgList" />
    </ScrollViewer>

    <!-- ================= 3 引用条 ================= -->
    <Border Grid.Row="3" Padding="14,7,14,7" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtEvidence" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Muted}" />
        <Button x:Name="BtnEvidence" Grid.Column="1" Style="{StaticResource Btn.Mini}" Content="查看引用"
                Click="OnEvidenceToggle" Margin="0,0,6,0" />
        <Button Grid.Column="2" Style="{StaticResource Btn.Mini}" Content="复制回答"
                Click="OnCopyLast" ToolTip="复制最近一条 AI 回答到剪贴板" />
      </Grid>
    </Border>

    <!-- ================= 4 引用详情（可折叠，不占默认首屏） ================= -->
    <Border x:Name="EvidencePane" Grid.Row="4" Visibility="Collapsed"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <Grid Height="176">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="278" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="EvidenceList" Grid.Column="0" BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource B.Border}" FontSize="11"
                 SelectionChanged="OnEvidenceSel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="3,3"
                         ToolTip="{Binding}" Foreground="{DynamicResource B.Text}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="10,7">
          <TextBox x:Name="EdtEvidenceDetail" IsReadOnly="True" TextWrapping="Wrap"
                   BorderThickness="0" Background="Transparent" FontSize="11.5"
                   Foreground="{DynamicResource B.Text}" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ================= 5 输入区 ================= -->
    <Border Grid.Row="5" Padding="14,8,14,10" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <TextBlock Text="快捷提问" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource B.Faint}" />
          <Button Style="{StaticResource Chip}" Content="基本物耗能不能另收？" Click="OnQuick"
                  Tag="基本物耗能不能另收？立项指南的计价说明是怎么规定的？" />
          <Button Style="{StaticResource Chip}" Content="加收项怎么计价？" Click="OnQuick"
                  Tag="加收项能不能单独收费？计价单位和主项目是什么关系？" />
          <Button Style="{StaticResource Chip}" Content="换药的价格构成" Click="OnQuick"
                  Tag="换药项目的价格构成包含哪些内容？" />
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="EdtQuestion" Grid.Column="0" Style="{StaticResource Tb}"
                   Height="62" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalContentAlignment="Top" Padding="9,7"
                   KeyDown="OnQuestionKey"
                   ToolTip="输入项目名称或计价疑问；Enter 发送，Shift+Enter 换行" />
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
            <Button x:Name="BtnSend" Style="{StaticResource Btn.Primary}" Content="解读"
                    Width="84" Height="30" Click="OnSend" />
            <Button x:Name="BtnStop" Style="{StaticResource Btn.Ghost}" Content="停止"
                    Width="84" Height="26" Margin="0,6,0,0" Visibility="Collapsed" Click="OnStop" />
          </StackPanel>
        </Grid>

        <TextBlock x:Name="TxtHint" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Faint}" />
      </StackPanel>
    </Border>

    <!-- ================= 设置面板（覆盖内容区，默认收起） ================= -->
    <Grid x:Name="SettingsView" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed"
          Background="{DynamicResource B.Card}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="16,10,14,10" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="模型 API 与地区设置" FontSize="13.5" FontWeight="Bold"
                       Foreground="{DynamicResource B.Text}" />
            <TextBlock Text="配置只保存在本机 data/price-ai.json，不参与数据分发；密钥不写日志、界面只显示遮盖值。"
                       FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource B.Muted}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                  Click="OnSettingsClose" ToolTip="关闭设置（未保存的修改会丢弃）">
            <TextBlock Text="✕" FontSize="11.5" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,6">
        <StackPanel>
          <TextBlock Text="服务商预设" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="CbProvider" Style="{StaticResource Cb}" Width="330" HorizontalAlignment="Left"
                    DisplayMemberPath="Name" SelectionChanged="OnProviderPick" />
          <TextBlock x:Name="TxtProviderHint" Style="{StaticResource FieldNote}" Margin="0,4,0,12" />

          <TextBlock Text="接口地址 Base URL" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="EdtBaseUrl" Style="{StaticResource Tb}" Height="30"
                   ToolTip="填到 /v1 这一层即可，程序自动补 /chat/completions；也支持已含完整路径的地址" />
          <TextBlock Text="例如 https://api.deepseek.com/v1 · 百炼要带 /compatible-mode/v1 · 智谱是 /api/paas/v4 · 院内 Ollama 用 http://127.0.0.1:11434/v1"
                     Style="{StaticResource FieldNote}" Margin="0,3,0,12" />

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="API Key（本机保存）" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="PwbKey" Style="{StaticResource Pwb}" Height="30" />
              <TextBlock Text="内网自建模型无需鉴权可留空" Style="{StaticResource FieldNote}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="EdtModel" Style="{StaticResource Tb}" Height="30" />
              <TextBlock Text="以服务商控制台实际模型名为准" Style="{StaticResource FieldNote}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="适用地区" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="EdtRegion" Style="{StaticResource Tb}" Height="30" />
          <TextBlock x:Name="TxtRegionNote" Style="{StaticResource FieldNote}" Margin="0,3,0,12"
                     Text="本地落地价库目前只收录山东省德州市；其它地区只按国家立项指南条文解读计价规则，不报具体金额。" />

          <TextBlock Text="检索与生成参数" Style="{StaticResource FieldLabel}" />
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="引用指南条数" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtTopK" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="温度（0~1）" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtTemp" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="超时（秒）" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtTimeout" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,6,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="解读辅导条数" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtJieduK" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="地区价格条数" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtPriceK" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="最大 token" FontSize="10.5" Foreground="{DynamicResource B.Muted}" />
              <TextBox x:Name="EdtMaxTokens" Style="{StaticResource Tb}" Height="28" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>

          <Border Padding="10,8" Background="{DynamicResource B.InfoBg}"
                  BorderBrush="{DynamicResource B.InfoBorder}" BorderThickness="1" CornerRadius="6">
            <TextBlock FontSize="10.5" TextWrapping="Wrap" LineHeight="16"
                       Foreground="{DynamicResource B.InfoText}"
                       Text="本模块只把「你输入的问题 + 本机检索出的政策条文」发给你自己配置的模型，不上传病历、不上传业务数据。回答里的 [G]/[J]/[P] 编号可在「查看引用」里逐条核对原文。" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="16,9,16,10" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtSettingsStatus" Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Muted}" />
          <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="测试连接" Width="86" Height="30"
                  Click="OnTestSettings" Margin="0,0,7,0" />
          <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="取消" Width="66" Height="30"
                  Click="OnSettingsClose" Margin="0,0,7,0" />
          <Button Grid.Column="3" Style="{StaticResource Btn.Primary}" Content="保存" Width="76" Height="30"
                  Click="OnSaveSettings" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
