<UserControl x:Class="Dip3GrouperApp.Desktop.Views.GuifanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dip3GrouperApp.Desktop">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="2,0,0,12">
      <TextBlock Style="{StaticResource PageTitle}" Text="项目技术规范查询" VerticalAlignment="Center" />
      <TextBlock x:Name="StatText" Style="{StaticResource Desc}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <!-- 多条件筛选：类别 / 章 / 计量单位 / 耗材 + 关键词（拼音全拼与首字母），键入 280ms 防抖后自动检索 -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <ComboBox x:Name="CatSel" Style="{StaticResource Cb}" Width="126" Margin="0,0,8,0"
                ToolTip="按项目类别筛选" SelectionChanged="OnCatChanged" />
      <ComboBox x:Name="ChapSel" Style="{StaticResource Cb}" Width="170" Margin="0,0,8,0"
                ToolTip="按章筛选（随类别联动）" SelectionChanged="OnFilterChanged" />
      <ComboBox x:Name="UnitSel" Style="{StaticResource Cb}" Width="104" Margin="0,0,8,0"
                ToolTip="按计量单位筛选" SelectionChanged="OnFilterChanged" />
      <ComboBox x:Name="MatSel" Style="{StaticResource Cb}" Width="126" Margin="0,0,8,0"
                ToolTip="按必需耗材有无筛选" SelectionChanged="OnFilterChanged" />
      <TextBox x:Name="GfQuery" Style="{StaticResource Tb}" Width="240" Margin="0,0,8,0"
               PreviewKeyDown="OnQueryKey" TextChanged="OnQueryText"
               ToolTip="编码前缀 / 名称 / 内涵 / 耗材 / 票据分类；支持全拼与首字母（如 ptmzzc → 普通门诊诊察）" />
      <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="0,0,8,0" Click="OnSearch" />
      <Button Style="{StaticResource Btn.Ghost}" Content="清 空" Click="OnClear"
              ToolTip="清空关键词与全部筛选，恢复全部项目" />
      <TextBlock x:Name="GfStatus" Style="{StaticResource Desc}" Margin="14,0,0,0"
                 VerticalAlignment="Center" />
    </WrapPanel>

    <!-- 右键：复制（选中文字 / 编码 / 名称 / 本行 / 详情全文）、打开跨库关联 -->
    <DataGrid Grid.Row="2" x:Name="GfGrid" Style="{StaticResource Dg.ReadOnly}"
              local:RowMenu.Enable="True" local:DetailToggle.Enable="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              RowDetailsVisibilityMode="VisibleWhenSelected">
      <DataGrid.RowDetailsTemplate>
        <DataTemplate>
          <Border Margin="10,4,10,10" Background="{DynamicResource B.SoftBg}"
                  BorderBrush="{DynamicResource B.SoftBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
              <!-- 星号列承载长文本：横向 StackPanel 会给子元素无限宽度导致永不换行 -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="4" Style="{StaticResource Btn.Link}" Content="收起"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        local:DetailToggle.Collapse="True"
                        ToolTip="收起本行详情（也可直接点卡片空白处，或再点一次本行）" />
                <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
                  <TextBox Style="{StaticResource Tx.Sel}" Text="{Binding Code, Mode=OneWay}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                </Border>
                <TextBox Grid.Column="1" Style="{StaticResource Tx.Sel}" Text="{Binding Name, Mode=OneWay}"
                         FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource ChipText}" Text="{Binding Category}" />
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasUnit, Converter={StaticResource BoolToVis}}">
                  <TextBlock Style="{StaticResource ChipText}" Text="{Binding UnitChip}" />
                </Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding Meters}" Margin="0,2,0,10"
                            Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,4">
                          <TextBlock Text="{Binding Label}" FontSize="12.5"
                                     Foreground="{DynamicResource B.Muted}" />
                          <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="Bold"
                                     FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource B.Text}"
                                     HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Style="{StaticResource Meter.Bar}"
                                     Maximum="100" Value="{Binding Value}"
                                     Background="{DynamicResource B.Border}"
                                     Foreground="{Binding BarColor}" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Blocks}"
                            ItemTemplate="{StaticResource Block.Tpl}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>
    </DataGrid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button x:Name="GfPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="上一页" Click="OnPrev" />
      <TextBlock x:Name="GfPageInfo" Style="{StaticResource Desc}" Margin="14,0"
                 VerticalAlignment="Center" />
      <Button x:Name="GfNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="下一页" Click="OnNext" />
    </StackPanel>
  </Grid>
</UserControl>
