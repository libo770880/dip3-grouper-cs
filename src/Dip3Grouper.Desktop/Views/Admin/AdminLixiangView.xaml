<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminLixiangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Dip3GrouperApp.Desktop.Controls">
  <Grid Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 标题 + 视图切换 -->
      <Grid Grid.Row="0" Margin="2,0,0,12">
        <TextBlock Style="{StaticResource PageTitle}" Text="立项指南" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="TxtMeta" Style="{StaticResource Desc}" VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <Border Style="{StaticResource Segment.Bar}" ctl:Segment.Track="True">
            <Grid>
              <Border Style="{StaticResource Segment.Slide}" />
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SegItems" GroupName="AdminLxView" Style="{StaticResource Segment.Item}"
                             Content="价格项目" IsChecked="True" Checked="OnViewChanged" />
                <RadioButton x:Name="SegJiedu" GroupName="AdminLxView" Style="{StaticResource Segment.Item}"
                             Content="解读辅导" Checked="OnViewChanged" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ==================== 价格项目 ==================== -->
      <Grid Grid.Row="1" x:Name="ItemsView">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <ComboBox x:Name="SectionSel" Style="{StaticResource Cb}" Width="250"
                    SelectionChanged="OnSectionChanged" />
          <TextBox x:Name="QueryBox" Style="{StaticResource Tb}" Width="300" Margin="8,0,0,0"
                   PreviewKeyDown="OnQueryKey" />
          <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="8,0,0,0" Click="OnSearch" />
          <TextBlock x:Name="StatusText" Style="{StaticResource Desc}" Margin="14,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Style="{StaticResource Btn.Mini.Primary}" Content="区段导入" Click="OnImport"
                  ToolTip="导入当前区段的 Excel（表头需含「项目名称」）" />
          <Button Style="{StaticResource Btn.Mini}" Content="下载模板" Margin="6,0,0,0"
                  Click="OnTemplate" />
          <Button Style="{StaticResource Btn.Mini}" Content="类别使用说明" Margin="6,0,0,0"
                  Click="OnEditGuideUsage" ToolTip="维护本区段的「本类使用说明」（类别级）" />
          <Border Width="1" Background="{DynamicResource B.Border}" Margin="12,3" />
          <Button Style="{StaticResource Btn.Mini.Primary}" Content="新 增" Click="OnAdd" />
          <Button Style="{StaticResource Btn.Mini}" Content="编 辑" Margin="6,0,0,0" Click="OnEdit" />
          <Button Style="{StaticResource Btn.Mini.Danger}" Content="删 除" Margin="6,0,0,0" Click="OnDelete" />
        </StackPanel>

        <!-- 类别使用说明预览（限高 + 内部滚动，避免长文本挤压下方列表） -->
        <Border Grid.Row="2" x:Name="UsageBox" Visibility="Collapsed" Margin="0,0,0,10"
                Background="{DynamicResource B.InfoBg}" BorderBrush="{DynamicResource B.InfoBorder}" BorderThickness="1" CornerRadius="10"
                Padding="14,10" MaxHeight="148">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}"
                           Text="本类使用说明" />
                <TextBlock x:Name="UsageMore" FontSize="11.5" Foreground="{DynamicResource B.Faint}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="UsageText" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                         Foreground="{DynamicResource B.InfoText}" Margin="0,5,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource Dg.ReadOnly}"
                  MouseDoubleClick="OnRowDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="序号" Width="62">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding Seq}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="项目名称" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Name}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="项目类别" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Category}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="计价单位" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Unit}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="使用说明（计价说明）" Width="330">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Usage}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <Border Margin="10,4,10,10" Background="{DynamicResource B.SoftBg}" BorderBrush="{DynamicResource B.SoftBorder}"
                      BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource ChipText}" Text="{Binding SeqChip}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="Bold"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" FontSize="12.5"
                                     Foreground="{DynamicResource B.Muted}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                     TextWrapping="Wrap" LineHeight="21"
                                     Foreground="{DynamicResource B.Text}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Button x:Name="BtnPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                  FontSize="12.5" Content="上一页" Click="OnPrev" />
          <TextBlock x:Name="PageInfo" Style="{StaticResource Desc}" Margin="14,0"
                     VerticalAlignment="Center" />
          <Button x:Name="BtnNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
                  FontSize="12.5" Content="下一页" Click="OnNext" />
        </StackPanel>
      </Grid>

      <!-- ==================== 解读辅导 ==================== -->
      <Grid Grid.Row="1" x:Name="JieduView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <ComboBox x:Name="IssueSel" Style="{StaticResource Cb}" Width="190"
                    SelectionChanged="OnIssueChanged" />
          <TextBox x:Name="JdQuery" Style="{StaticResource Tb}" Width="340" Margin="8,0,0,0"
                   PreviewKeyDown="OnJdQueryKey" />
          <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="8,0,0,0" Click="OnJdSearch" />
          <TextBlock x:Name="JdStatus" Style="{StaticResource Desc}" Margin="14,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
          <Button Style="{StaticResource Btn.Mini.Primary}" Content="导入解读文档" Click="OnJieduImport"
                  ToolTip="支持 .doc / .docx / .txt（WPS 导出亦可）" />
          <Button Style="{StaticResource Btn.Mini.Danger}" Content="删除本期" Margin="6,0,0,0"
                  Click="OnJieduDeleteIssue" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="JdGrid" Style="{StaticResource Dg.ReadOnly}"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="期次" Width="92">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding IssueText}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="题号" Width="72">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellMono}" Text="{Binding No}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="解读问题" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Style="{StaticResource DgCellText}" Text="{Binding Q}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <Border Margin="10,4,10,10" Background="{DynamicResource B.SoftBg}" BorderBrush="{DynamicResource B.SoftBorder}"
                      BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource ChipText}" Text="{Binding IssueChip}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Q}" FontSize="13" FontWeight="Bold"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock Text="{Binding A}" FontSize="12.5" TextWrapping="Wrap"
                             LineHeight="22" Foreground="{DynamicResource B.InfoText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="JdPageInfo" Style="{StaticResource Desc}"
                   HorizontalAlignment="Center" Margin="0,10,0,0" />
      </Grid>
        <!-- 页面渐显（控件见 Controls/BusyVeil），与前台立项指南页同一套反馈 -->
      <ctl:BusyVeil x:Name="Busy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50" />
  </Grid>
</UserControl>
