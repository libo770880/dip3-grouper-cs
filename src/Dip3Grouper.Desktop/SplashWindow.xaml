<Window x:Class="Dip3GrouperApp.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动中"
        Width="470" Height="336"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <!-- 外层留白给投影，避免阴影被窗口边缘裁掉 -->
  <Border Margin="18" CornerRadius="16"
          Background="{DynamicResource B.Card}"
          BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                        Color="#0f1728" Opacity="0.26" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="126" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ 品牌区（主题渐变） ============ -->
      <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="{DynamicResource B.LogoBox}">
        <Grid Margin="26,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="11" Background="#33ffffff"
                    BorderBrush="#4dffffff" BorderThickness="1">
              <TextBlock x:Name="TxtLogo" Text="DIP" Foreground="#ffffff"
                         FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtAppName" Text="DIP 3.0 分组器"
                         Foreground="#ffffff" FontSize="18" FontWeight="Bold" LineHeight="21" />
              <TextBlock x:Name="TxtSubName" Foreground="#ccffffff" FontSize="11.5"
                         LineHeight="14" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 进度区 ============ -->
      <Grid Grid.Row="1" Margin="28,0,28,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TxtStage" Text="正在启动…"
                     FontSize="13" Foreground="{DynamicResource B.Text}" />
          <Grid Height="9" Margin="0,11,0,0">
            <Border x:Name="Track" CornerRadius="4.5" Background="{DynamicResource B.SegBg}" />
            <Border x:Name="Fill" Width="0" CornerRadius="4.5" HorizontalAlignment="Left">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
                  <GradientStop Color="{DynamicResource Color.AccentHover}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
          <Grid Margin="0,9,0,0">
            <TextBlock x:Name="TxtHint" FontSize="11.5"
                       Foreground="{DynamicResource B.Muted}"
                       Text="首次启动需载入病种库与立项指南，请稍候" />
            <TextBlock x:Name="TxtPct" Text="0%" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Accent}"
                       HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Grid>

      <!-- ============ 页脚 ============ -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource B.Border}"
              Padding="28,11">
        <TextBlock x:Name="TxtFooter" FontSize="11"
                   Foreground="{DynamicResource B.Faint}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</Window>
