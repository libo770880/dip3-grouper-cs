<UserControl x:Class="Dip3GrouperApp.Desktop.Views.SingleGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Dip3GrouperApp.Desktop.Controls">
  <!-- 统一节奏：外层左右 20 / 上下 16，内容占满窗口 -->
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 页面标题 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="单条分组" />
      <TextBlock Style="{StaticResource Desc}" Margin="12,0,0,3"
                 VerticalAlignment="Bottom"
                 Text="输入病案诊断与手术信息，实时分组" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="436" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ============ 表单（自身过高时内部滚动） ============ -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}"
                       Text="主要诊断" Margin="0,0,0,9" />
            <ctrl:SuggestBox Grid.Row="0" Grid.Column="1" x:Name="DiagMain"
                             Kind="diag" Placeholder="A09.901 或 胃肠炎" Margin="0,0,0,9" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}"
                       Text="其他诊断" Margin="0,0,0,9" />
            <ctrl:SuggestBox Grid.Row="1" Grid.Column="1" x:Name="DiagOther" Multi="True"
                             Kind="diag" Placeholder="C34.900;P05.900" Margin="0,0,0,9" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}"
                       Text="主要手术操作" Margin="0,0,0,9" />
            <ctrl:SuggestBox Grid.Row="2" Grid.Column="1" x:Name="ProcMain"
                             Kind="proc" Placeholder="99.2503 或 植皮术" Margin="0,0,0,9" />

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}"
                       Text="其他手术操作" Margin="0,0,0,9" />
            <ctrl:SuggestBox Grid.Row="3" Grid.Column="1" x:Name="ProcOther" Multi="True"
                             Kind="proc" Placeholder="99.2800x005;40.5901" Margin="0,0,0,9" />

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}"
                       Text="年龄" Margin="0,0,0,9" />
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="AgeBox" Style="{StaticResource Tb}"
                       Margin="0,0,8,0" PreviewKeyDown="OnEnterGroup" />
              <ComboBox Grid.Column="1" x:Name="AgeUnit" Style="{StaticResource Cb}" />
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}"
                       Text="出生体重" Margin="0,0,0,9" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="BirthWeight" Style="{StaticResource Tb}"
                       Margin="0,0,8,0" PreviewKeyDown="OnEnterGroup" />
              <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="克" />
            </Grid>

            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="UseMapping" Style="{StaticResource Cbx}"
                      Content="启用诊断映射转换（ICD-10 → 医保编码）" Margin="0,2,0,14" />

            <!-- 操作区：清空 / 填入示例 / 分组 —— 三个按钮同高（32，与输入框一致）、等高对齐 -->
            <Grid Grid.Row="7" Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" x:Name="BtnClear" Style="{StaticResource Btn.Ghost}"
                      Content="清 空" Height="32" Margin="0,0,8,0" Click="OnClear"
                      ToolTip="清空全部输入并复位结果区" />
              <Button Grid.Column="1" x:Name="BtnSample" Style="{StaticResource Btn.Ghost}"
                      Content="填入示例" Height="32" Margin="0,0,8,0" Click="OnFillSample"
                      ToolTip="填入一条能命中核心病种的示例病案并立即分组（A09.901 + 44.1300x001）" />
              <Button Grid.Column="2" x:Name="BtnGroup" Style="{StaticResource Btn.Primary}"
                      Content="分 组" Height="32" Click="OnGroup" />
            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>

      <!-- ============ 结果（占满剩余高度，内容过高内部滚动） ============ -->
      <Border Grid.Column="1" Style="{StaticResource ResultCard}" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="ResultHost" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
