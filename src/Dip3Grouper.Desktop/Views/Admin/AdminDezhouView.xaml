<UserControl x:Class="Dip3GrouperApp.Desktop.Views.Admin.AdminDezhouView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题 + 统计（两列，避免长统计文字压住标题） -->
    <Grid Grid.Row="0" Margin="2,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource PageTitle}" Text="德州物价" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <TextBlock x:Name="TxtMeta" Style="{StaticResource Desc}" VerticalAlignment="Center"
                   Margin="0,0,12,0" MaxWidth="560" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatText" Style="{StaticResource Desc}" VerticalAlignment="Center"
                   MaxWidth="430" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <!-- 筛选 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <ComboBox x:Name="DocSel" Style="{StaticResource Cb}" Width="252"
                SelectionChanged="OnDocChanged" />
      <ComboBox x:Name="CatSel" Style="{StaticResource Cb}" Width="168" Margin="8,0,0,0"
                SelectionChanged="OnFilterChanged" />
      <ComboBox x:Name="KindSel" Style="{StaticResource Cb}" Width="128" Margin="8,0,0,0"
                SelectionChanged="OnFilterChanged" />
      <TextBox x:Name="QueryBox" Style="{StaticResource Tb}" Width="232" Margin="8,0,0,0"
               PreviewKeyDown="OnQueryKey" />
      <Button Style="{StaticResource Btn.Primary}" Content="查 询" Margin="8,0,0,0" Click="OnSearch" />
      <TextBlock x:Name="StatusText" Style="{StaticResource Desc}" Margin="14,0,0,0"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- 维护工具栏 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Style="{StaticResource Btn.Mini.Primary}" Content="新 增" Click="OnAdd"
              ToolTip="在当前批次/类别下新增一条项目" />
      <Button Style="{StaticResource Btn.Mini}" Content="编 辑" Margin="6,0,0,0" Click="OnEdit" />
      <Button Style="{StaticResource Btn.Mini.Danger}" Content="删 除" Margin="6,0,0,0" Click="OnDelete" />
      <Border Width="1" Background="{DynamicResource B.Border}" Margin="12,3" />
      <Button Style="{StaticResource Btn.Mini.Primary}" Content="导入 Excel" Click="OnImport"
              ToolTip="表头需含「项目编码」与「项目名称」，可先下载模板" />
      <Button Style="{StaticResource Btn.Mini}" Content="下载模板" Margin="6,0,0,0" Click="OnTemplate" />
      <Button Style="{StaticResource Btn.Mini}" Content="导出当前视图" Margin="6,0,0,0" Click="OnExport"
              ToolTip="按当前筛选条件导出为 Excel" />
    </StackPanel>

    <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource Dg.ReadOnly}"
              RowDetailsVisibilityMode="VisibleWhenSelected" MouseDoubleClick="OnRowDoubleClick">
      <DataGrid.RowDetailsTemplate>
        <DataTemplate>
          <Border Margin="10,4,10,10" Background="{DynamicResource B.SoftBg}"
                  BorderBrush="{DynamicResource B.SoftBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource ChipText}" Text="{Binding Code}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="Bold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource ChipText}" Text="{Binding KindLabel}" />
                </Border>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="126" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="三级 / 二级 / 一级" FontSize="12.5"
                           Foreground="{DynamicResource B.Muted}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding PriceLine}" FontSize="12.5"
                           FontFamily="{StaticResource Font.Mono}"
                           Foreground="{DynamicResource B.Text}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="126" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" FontSize="12.5"
                                 Foreground="{DynamicResource B.Muted}" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                 TextWrapping="Wrap" LineHeight="21"
                                 Foreground="{DynamicResource B.Text}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>
    </DataGrid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
      <Button x:Name="BtnPrev" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="上一页" Click="OnPrev" />
      <TextBlock x:Name="PageInfo" Style="{StaticResource Desc}" Margin="14,0"
                 VerticalAlignment="Center" />
      <Button x:Name="BtnNext" Style="{StaticResource Btn.Ghost}" Padding="12,4" MinHeight="28"
              FontSize="12.5" Content="下一页" Click="OnNext" />
    </StackPanel>
  </Grid>
</UserControl>
