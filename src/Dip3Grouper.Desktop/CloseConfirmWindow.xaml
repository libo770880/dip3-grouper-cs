<Window x:Class="Dip3GrouperApp.Desktop.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关闭程序" Width="452" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.BorderStrong}"
          BorderThickness="1" CornerRadius="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.20" Color="#0f1728" />
    </Border.Effect>

    <DockPanel>
      <!-- ============ 标题栏（可拖动 + 关闭＝取消） ============ -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource B.SoftBg}" CornerRadius="12,12,0,0"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnHeadDrag">
        <Grid Height="42">
          <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                     FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                     Text="关闭程序" />
          <Button Style="{StaticResource WinBtn.Close}" HorizontalAlignment="Right" Margin="0,0,6,0"
                  Click="OnCancel" ToolTip="取消">
            <Path Style="{StaticResource WinIcon}"
                  Data="M 0.6 0.6 L 10.4 10.4 M 10.4 0.6 L 0.6 10.4" />
          </Button>
        </Grid>
      </Border>

      <!-- ============ 底部按钮 ============ -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource B.SoftBg}"
              CornerRadius="0,0,12,12" BorderBrush="{DynamicResource B.Border}"
              BorderThickness="0,1,0,0" Padding="16,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- 取消＝IsCancel：Esc 与点击都走 WPF 默认的 DialogResult=false，
               不再挂 Click（处理器里再设一次 DialogResult 会在窗口已关闭后抛异常） -->
          <Button Style="{StaticResource Btn.Ghost}" Content="取 消" IsCancel="True" />
          <Button Style="{StaticResource Btn.Ghost}" Content="退出程序" Margin="8,0,0,0" Click="OnExit" />
          <Button Style="{StaticResource Btn.Primary}" Content="最小化到托盘" Margin="8,0,0,0"
                  IsDefault="True" Click="OnTray" />
        </StackPanel>
      </Border>

      <!-- ============ 正文 ============ -->
      <StackPanel Margin="20,18,20,4">
        <StackPanel Orientation="Horizontal">
          <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top"
                  Background="{DynamicResource B.AccentSoft}">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource B.Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtAskTitle" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Text="要退出，还是留在后台？" />
            <TextBlock x:Name="TxtAskSub" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       LineHeight="18" Foreground="{DynamicResource B.Muted}" />
          </StackPanel>
        </StackPanel>

        <CheckBox x:Name="ChkRemember" Style="{StaticResource Cbx}" Margin="0,18,0,0"
                  Content="记住我的选择，以后不再询问" />
        <TextBlock Style="{StaticResource Desc}" Margin="22,7,0,0" TextWrapping="Wrap" LineHeight="17"
                   Text="不勾选则本次生效，下次点关闭仍会问你；随时可在「后台管理 → 系统设置 → 窗口与托盘」里改回来。" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
