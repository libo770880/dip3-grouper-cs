<Application x:Class="Dip3GrouperApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="OnStartup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 顺序敏感：Controls / Data 中的 StaticResource 依赖 Colors -->
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Themes/Data.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 表格行高：UiPrefs.Apply() 会在启动与切换密度时改写（紧凑 26 / 标准 34）。
           只有列表型表格绑定它，详情类 DataGrid 仍用固定行高，避免多行单元格被裁。 -->
      <sys:Double x:Key="DgRowHeight">26</sys:Double>
    </ResourceDictionary>
  </Application.Resources>
</Application>
