<UserControl x:Class="Dip3GrouperApp.Desktop.GuidePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Grid Background="{DynamicResource B.Card}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ================= 头部：标题 + 价格档（二级 / 三级） ================= -->
    <Border Grid.Row="0" Padding="16,11,12,11" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 从工具栏进来时留一个返回位：回去看工具列表（独立截图时不显示） -->
        <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource Btn.Icon}"
                Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"
                Visibility="Collapsed" Click="OnBack" ToolTip="返回工具栏">
          <TextBlock Text="‹" FontSize="17" Margin="0,-2,0,0" />
        </Button>

        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,11,0"
                Background="{DynamicResource B.Accent}" VerticalAlignment="Center">
          <TextBlock Text="病" Foreground="{DynamicResource B.White}" FontSize="14" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="TxtTitle" Text="病理开具指引" FontSize="14" FontWeight="Bold"
                     Foreground="{DynamicResource B.Text}" />
          <TextBlock x:Name="TxtSub" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource B.Muted}" />
        </StackPanel>

        <!-- 价格档：开具前先确认本院等级，金额随档位整表切换 -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="价格档" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource B.Muted}" />
          <RadioButton x:Name="RdoLv2" GroupName="Lv" Style="{StaticResource Pill}" Content="二级"
                       IsChecked="True" Checked="OnLevelChanged" Margin="0,0,0,0"
                       ToolTip="德州市二级医院价格（诊断费 99 / 处理 35 / 染色 34·39）" />
          <RadioButton x:Name="RdoLv3" GroupName="Lv" Style="{StaticResource Pill}" Content="三级"
                       Checked="OnLevelChanged" Margin="6,0,0,0"
                       ToolTip="德州市三级医院价格（诊断费 117 / 处理 41 / 染色 40·45）" />
        </StackPanel>

        <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Click="OnClose" ToolTip="收起（Esc）"
                Width="26" Height="26" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="✕" FontSize="11.5" />
        </Button>
      </Grid>
    </Border>

    <!-- ================= 检索条 ================= -->
    <Border Grid.Row="1" Padding="16,9,16,9"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,8,0">
          <TextBox x:Name="TxtQuery" Style="{StaticResource Tb}" Height="30" TextChanged="OnQueryText"
                   ToolTip="疾病 / 标本 / 部位关键词，空格分隔多个词（如：宫颈 活检）" />
          <TextBlock x:Name="TxtHint" Text="搜疾病 / 标本 / 部位，如：宫颈、ESD、甲状腺"
                     FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource B.Faint}" IsHitTestVisible="False" />
        </Grid>

        <ComboBox x:Name="KindSel" Grid.Column="1" Style="{StaticResource Cb}" Width="104" Height="30"
                  SelectionChanged="OnFilterChanged" ToolTip="按档位类型筛选" />
        <TextBlock x:Name="TxtStatus" Grid.Column="2" Style="{StaticResource Desc}"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- ================= 主体：疾病系统 + 档位表 ================= -->
    <Grid Grid.Row="2" Margin="16,11,16,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="9" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="疾病系统" Style="{StaticResource Label}" Margin="11,9,11,5" />
          <ListBox x:Name="SysList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnSystemChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Width="142" Margin="0,1">
                  <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,22,0"
                             ToolTip="{Binding Name}" />
                  <TextBlock Text="{Binding Count}" FontSize="10.5" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Foreground="{DynamicResource B.Muted}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <DataGrid x:Name="ItemGrid" Grid.Column="1" Style="{StaticResource Dg.ReadOnly}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="OnEntryChanged" MouseDoubleClick="OnEntryDoubleClick"
                RowHeaderWidth="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="档位" Binding="{Binding Tier}" Width="128" />
          <DataGridTemplateColumn Header="标本 / 适应证" Width="*" MinWidth="260">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Sample}" TextWrapping="Wrap" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,2" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- ================= 计价区：明细 + 数量 / 合计 ================= -->
    <Border Grid.Row="3" Padding="16,10,16,11" Background="{DynamicResource B.SoftBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="264" />
        </Grid.ColumnDefinitions>

        <!-- 左：收费明细（物价名称逐条列出，收费员照单点） -->
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock x:Name="TxtPick" Text="在上表选一条，或直接改蜡块数" FontSize="12.5"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource B.Text}" />
          <TextBlock x:Name="TxtPickSample" FontSize="11.5" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource B.Muted}" />

          <ItemsControl x:Name="PriceList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Note}" FontSize="10.5" Margin="7,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource B.Muted}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="11.5"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource B.Muted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12.5"
                             FontWeight="Bold" VerticalAlignment="Center" Width="76" TextAlignment="Right"
                             FontFamily="{StaticResource Font.Mono}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 右：计价类型 / 数量 / 合计 / 速算 -->
        <StackPanel Grid.Column="1">
          <Grid>
            <TextBlock Text="计价类型" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <ComboBox x:Name="ModeSel" HorizontalAlignment="Right" Style="{StaticResource Cb}"
                      Width="168" Height="28" SelectionChanged="OnModeChanged" />
          </Grid>

          <Grid Margin="0,7,0,0">
            <TextBlock x:Name="LblCount" Text="蜡块数" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Btn.Mini}" Content="−" Width="26" Height="26"
                      Click="OnWaxMinus" ToolTip="减 1" />
              <TextBox x:Name="TxtWax" Width="52" Height="26" Margin="6,0,6,0"
                       TextAlignment="Center" VerticalContentAlignment="Center"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold"
                       TextChanged="OnWaxText" />
              <Button Style="{StaticResource Btn.Mini}" Content="+" Width="26" Height="26"
                      Click="OnWaxPlus" ToolTip="加 1" />
            </StackPanel>
          </Grid>

          <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
            <Grid>
              <TextBlock Text="合计" VerticalAlignment="Bottom" FontSize="12"
                         Foreground="{DynamicResource B.Accent}" />
              <TextBlock x:Name="TxtTotal" Text="¥0" HorizontalAlignment="Right"
                         FontSize="21" FontWeight="Bold"
                         Foreground="{DynamicResource B.Accent}" FontFamily="{StaticResource Font.Mono}" />
            </Grid>
          </Border>

          <Grid Margin="0,7,0,0">
            <TextBlock x:Name="TxtQuick" Style="{StaticResource Desc}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Style="{StaticResource Btn.Ghost}" Content="速算蜡块" HorizontalAlignment="Right"
                    Padding="9,0" Height="24" MinHeight="24" FontSize="11.5"
                    Click="OnQuickPick" ToolTip="按瓶子/袋数、每袋块数、最大边长估算蜡块数" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 页脚：核定规则 / 专项价目 + 来源 ================= -->
    <Border Grid.Row="4" Padding="16,7,16,9"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <StackPanel>
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnRules" Style="{StaticResource Btn.Link}"
                    Content="蜡块核定规则 ▾" Click="OnToggleRules" />
            <Button x:Name="BtnSpec" Style="{StaticResource Btn.Link}" Margin="16,0,0,0"
                    Content="专项价目 ▾" Click="OnToggleSpec"
                    ToolTip="细胞病理 / 细胞蜡块 / 免疫组化 / 疑难会诊 / 基因检测" />
          </StackPanel>
          <TextBlock x:Name="TxtSource" Style="{StaticResource Desc}" HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock x:Name="TxtRules" FontSize="11" TextWrapping="Wrap"
                       LineHeight="17" Foreground="{DynamicResource B.Muted}" Visibility="Collapsed" />
            <TextBlock x:Name="TxtSpec" FontSize="11" TextWrapping="Wrap"
                       LineHeight="17" Foreground="{DynamicResource B.Muted}" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
