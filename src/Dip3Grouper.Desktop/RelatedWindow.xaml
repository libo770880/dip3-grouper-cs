<Window x:Class="Dip3GrouperApp.Desktop.RelatedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dip3GrouperApp.Desktop"
        Title="关联详情"
        Width="820" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <!-- 整窗可拖选复制；右键：复制名称 / 复制全部详情 / 继续打开关联条目 -->
  <Border Margin="16" CornerRadius="16" local:RowMenu.Enable="True"
          Background="{DynamicResource B.Card}"
          BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                        Color="#0f1728" Opacity="0.28" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ 头部：库标签 + 名称（可拖动） ============ -->
      <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="{DynamicResource B.SoftBg}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1"
              Padding="18,13" MouseLeftButtonDown="OnHeadDrag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Chip}" Padding="8,2" VerticalAlignment="Center"
                  Margin="0,0,10,0">
            <TextBlock x:Name="TxtLib" Style="{StaticResource ChipText}" FontSize="11.5" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="关联详情" FontSize="13.5" FontWeight="Bold"
                       Foreground="{DynamicResource B.Text}" />
            <TextBlock x:Name="TxtCrumb" FontSize="11.5" Margin="0,2,0,0"
                       Foreground="{DynamicResource B.Muted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Click="OnClose" ToolTip="关闭"
                  Width="28" Height="28" VerticalAlignment="Center">
            <TextBlock Text="✕" FontSize="12" />
          </Button>
        </Grid>
      </Border>

      <!-- ============ 正文 ============ -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="18,14,12,10">
        <StackPanel Margin="0,0,6,0">
          <!-- 标题行：编码徽章 + 名称 + 附加徽章 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Chip}" VerticalAlignment="Center"
                    Visibility="{Binding HasCodeChip, Converter={StaticResource BoolToVis}}">
              <TextBox Style="{StaticResource Tx.Sel}" Text="{Binding CodeChip, Mode=OneWay}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1" Style="{StaticResource Tx.Sel}" Text="{Binding Name, Mode=OneWay}"
                     FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"
                     Foreground="{DynamicResource B.Text}" />
            <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding HasExtraChip, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource ChipText}" Text="{Binding ExtraChip}" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="6,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding HasExtraChip2, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource ChipText}" Text="{Binding ExtraChip2}" />
            </Border>
          </Grid>

          <TextBox Style="{StaticResource Tx.Sel}" Text="{Binding Sub, Mode=OneWay}" FontSize="12"
                   Margin="0,0,0,12" Foreground="{DynamicResource B.Muted}"
                   Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}" />

          <!-- 技术规范：难度 / 风险 / 资源消耗量表 -->
          <ItemsControl ItemsSource="{Binding Meters}" Margin="0,0,0,10" Focusable="False"
                        Visibility="{Binding HasMeters, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="{Binding Label}" FontSize="12.5"
                                 Foreground="{DynamicResource B.Muted}" />
                      <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="Bold"
                                 FontFamily="{StaticResource Font.Mono}"
                                 Foreground="{DynamicResource B.Text}"
                                 HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Grid.Row="1" Style="{StaticResource Meter.Bar}"
                                 Maximum="100" Value="{Binding Value}"
                                 Background="{DynamicResource B.Border}"
                                 Foreground="{Binding BarColor}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 字段块（含跨库关联，链接可继续点开） -->
          <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource Block.Tpl}" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============ 底部 ============ -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Border}"
              Padding="18,12">
        <Grid>
          <Button x:Name="BtnBack" Style="{StaticResource Btn.Ghost}" Content="← 返回上一级"
                  Padding="12,4" MinHeight="30" FontSize="12.5"
                  HorizontalAlignment="Left" Click="OnBack" Visibility="Collapsed" />
          <Button Style="{StaticResource Btn.Primary}" Content="关 闭" Padding="18,4" MinHeight="30"
                  FontSize="12.5" HorizontalAlignment="Right" IsDefault="True" Click="OnClose" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
